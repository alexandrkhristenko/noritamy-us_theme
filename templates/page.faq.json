            },
            "accordion_row_HpmqgG": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Where are your products manufactured?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_8LXpQi": {
                  "type": "text",
                  "settings": {
                    "text": "<p>All Noritamy jewelry is <strong>designed and handcrafted in our studio in Israel</strong> by skilled artisans. Each piece is made by hand, combining bold contemporary design with timeless craftsmanship. Because our jewelry is handmade, no two pieces are exactly alike.</p>",
                    "width": "100%",
