              },
              "blocks": {
                "text_kQLzWY": {
                  "type": "text",
                  "settings": {
                    "text": "<p>We offer a <strong>30-day return policy</strong> from the date of delivery. Items must be unworn, in their original condition, and returned in the original Noritamy packaging. To initiate a return, please contact us at <a href=\"mailto:info@noritamy.com\">info@noritamy.com</a> with your order number. Once we receive and inspect the returned item, a refund will be issued to your original payment method within 5\u201310 business days.</p>",
                    "width": "100%",
                    "max_width": "normal",
