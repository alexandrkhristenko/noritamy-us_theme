                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_Pnmqxg": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Orders are processed within <strong>1\u20133 business days</strong>. Standard shipping within the US typically takes <strong>5\u20138 business days</strong> after dispatch. Expedited shipping options are available at checkout. You\u2019ll receive a confirmation email with a tracking number once your order ships.</p>",
