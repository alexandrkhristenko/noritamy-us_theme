            "accordion_row_sT9pLk": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How do I find my ring size?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_uT9pLm": {
                  "type": "text",
                  "settings": {
                    "text": "<p>We use <strong>US ring sizes</strong> for our US store. If you\u2019re unsure of your size, we recommend visiting a local jeweler for a professional measurement. You can also check our <a href=\"/pages/size-guide\">Size Guide</a> page for help. If you need further assistance, contact us at <a href=\"mailto:info@noritamy.com\">info@noritamy.com</a>.</p>",
                    "width": "100%",
