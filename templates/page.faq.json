              "blocks": {
                "text_zzCtMz": {
                  "type": "text",
                  "settings": {
                    "text": "<p>We offer <strong>free standard shipping on all US orders</strong>. Expedited shipping options are available at checkout for an additional fee. All orders are carefully packaged to ensure your jewelry arrives safely.</p>",
