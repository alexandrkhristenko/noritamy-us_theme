            "accordion_row_vW2nJh": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How do I care for my jewelry?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_xW2nJk": {
                  "type": "text",
                  "settings": {
                    "text": "<p>To keep your Noritamy jewelry looking its best:</p><ul><li><strong>Last on, first off.</strong> Put jewelry on after applying perfume, lotion, or makeup \u2014 and remove it before showering or sleeping.</li><li><strong>Keep it dry.</strong> Avoid wearing your pieces while swimming, bathing, or exercising.</li><li><strong>Soft touch only.</strong> Clean gently with a soft, dry cloth. No chemicals or abrasives.</li><li><strong>Store with care.</strong> Keep your piece in its Noritamy box or pouch, away from sunlight and other jewelry.</li><li><strong>Re-plating available.</strong> We offer a re-plating service when gold plating naturally fades over time.</li></ul>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "color": "var(--color-foreground)",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
