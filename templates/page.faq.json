                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_lJ9qXc": {
                  "type": "text",
                  "settings": {
                    "text": "<p>We do not offer direct exchanges. To get a different item, please <strong>return the original piece</strong> under our 30-day return policy, and then place a new order for the item you prefer. This ensures the fastest processing for you.</p>",
