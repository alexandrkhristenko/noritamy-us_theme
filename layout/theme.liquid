<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
  dir="ltr"
>
  <head>
    {%- comment -%}
      meta-tags renders <meta charset> and <meta name="viewport">. Both must appear within the
      first 1024 bytes of the document, otherwise the browser restarts parsing and mobile layout
      is delayed. Keep this render first in <head>.
    {%- endcomment -%}
    {%- render 'meta-tags' -%}

