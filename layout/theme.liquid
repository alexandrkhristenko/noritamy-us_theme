      </svg>
    </a>

    <script>
      // Отключаем нативное восстановление скролла браузером
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
      // Принудительно скроллим вверх при загрузке
      window.scrollTo(0, 0);
    </script>



    {% if settings.enable_cart_upsell_popup %}
      {% section 'cart-upsell-popup' %}
    {% endif %}
    <script async="" src="https://static.klaviyo.com/onsite/js/RQv57u/klaviyo.js?company_id=RQv57u"></script>
  </body>
</html>
