    <script>
      (function () {
        var currentUrl = window.location.href;

        var langPattern = /\/([a-z]{2}-[a-z]{2})(\/|$)/i;

        if (langPattern.test(currentUrl)) {
          var newUrl = currentUrl.replace(langPattern, '/');

          newUrl = newUrl.replace(/\/+$/, '/');

          if (newUrl.length > window.location.origin.length + 1) {
            newUrl = newUrl.replace(/\/$/, '');
          }

          if (newUrl !== currentUrl) {
            window.location.replace(newUrl);
          }
        }
      })();
    </script>

    {%- render 'stylesheets' -%}
    {{ 'noritamy-overrides.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'noritamy-quick-add.js' | asset_url }}" defer></script>

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    <link
      rel="expect"
      href="#MainContent"
      blocking="render"
      id="view-transition-render-blocker"
    >
    {%- render 'meta-tags' -%}
    {%- render 'product-schema' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
    {% comment %}
      <!-- Google Tag Manager -->
      <script>
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != 'dataLayer' ? '&l=' + l : '';
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', 'GTM-NFXS7F5F');
      </script>
      <!-- End Google Tag Manager -->
    {% endcomment %}
     <script src="https://t.contentsquare.net/uxa/353f6805c2fd9.js"></script>

  </head>
  {% render 'country-popup' %}
  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {% section 'breadcrumps' %}
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'search-modal' %}

    {% # theme-check-disable ParserBlockingScript %}
    <script src="{{ 'critical.js' | asset_url }}"></script>
    {% # theme-check-enable ParserBlockingScript %}
    <script src="{{ 'klaviyo-discount.js' | asset_url }}" defer="defer"></script>

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    {% if settings.mobile_bottom_nav and request.page_type != 'product' %}
      {% render 'noritamy-mobile-nav' %}
    {% endif %}


    {% if settings.enable_cart_upsell_popup %}
      {% section 'cart-upsell-popup' %}
    {% endif %}
    <!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MDXMWV7K"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
  </body>
</html>
