{% comment %}
  These five only power the product form and the product media gallery. That means the product
  template, or the quick-add modal, which fetches its markup on demand. Custom elements upgrade
  retroactively, so on a page whose initial markup contains none of them they can load after
  first paint instead of joining the ~30 modules already in the initial request chain.

  variant-picker is deliberately not in this list: product-card.js imports it, so it is fetched
  either way and deferring its own tag would save nothing.
{% endcomment %}
{% assign deferrable_product_scripts = 'product-form.js,media.js,product-inventory.js,component-quantity-selector.js,media-gallery.js' | split: ',' %}
{% if template.name == 'product' %}
  {% for product_script in deferrable_product_scripts %}
    <script
      src="{{ product_script | asset_url }}"
      type="module"
    ></script>
  {% endfor %}
{% else %}
  <script type="module">
    const productScripts = [
      {%- for product_script in deferrable_product_scripts -%}
        '{{ product_script | asset_url }}'{% unless forloop.last %}, {% endunless %}
      {%- endfor -%}
    ];

    let productScriptsRequested = false;
    const loadProductScripts = () => {
      if (productScriptsRequested) return;
      productScriptsRequested = true;
      for (const url of productScripts) import(url);
    };

    // A section on this page may already render a product form or gallery — a featured product,
    // for instance. Then there is nothing to defer and they load exactly as before.
    const productMarkup =
      'product-form-component, add-to-cart-component, quantity-selector-component, media-gallery, product-inventory, deferred-media, product-model';

    if (document.querySelector(productMarkup)) {
      loadProductScripts();
    } else {
      // Whichever comes first: the visitor reaching for quick add, or the browser going idle.
      addEventListener('pointerdown', loadProductScripts, { once: true, capture: true });
      addEventListener('keydown', loadProductScripts, { once: true, capture: true });

      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadProductScripts, { timeout: 3000 });
      } else {
        addEventListener('load', loadProductScripts, { once: true });
      }
    }
  </script>
{% endif %}
