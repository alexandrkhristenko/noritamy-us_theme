{%- liquid
  assign show_uk = false
  if localization.country.iso_code == 'GB'
    assign show_uk = true
  endif
-%}
<div class="size-guide-container">
  <div class="size-guide-title">Ring Size Conversion Chart</div>
  <table class="size-guide-table">
    <thead>
      <tr>
        <th>Inside Diameter (mm)</th>
        <th>US Size</th>
        <th>European Size</th>
        {%- if show_uk %}<th>UK Size</th>{% endif %}
      </tr>
    </thead>
    <tbody>
      <tr><td>14.1</td><td>3</td><td>44</td>{%- if show_uk %}<td>F</td>{% endif %}</tr>
      <tr><td>14.5</td><td>3.5</td><td>45</td>{%- if show_uk %}<td>G</td>{% endif %}</tr>
      <tr><td>14.9</td><td>4</td><td>47</td>{%- if show_uk %}<td>H</td>{% endif %}</tr>
      <tr><td>15.3</td><td>4.5</td><td>48</td>{%- if show_uk %}<td>I</td>{% endif %}</tr>
      <tr><td>15.7</td><td>5</td><td>49</td>{%- if show_uk %}<td>J</td>{% endif %}</tr>
      <tr><td>16.1</td><td>5.5</td><td>51</td>{%- if show_uk %}<td>K</td>{% endif %}</tr>
      <tr><td>16.5</td><td>6</td><td>52</td>{%- if show_uk %}<td>L</td>{% endif %}</tr>
      <tr><td>16.9</td><td>6.5</td><td>53</td>{%- if show_uk %}<td>M</td>{% endif %}</tr>
      <tr><td>17.3</td><td>7</td><td>54</td>{%- if show_uk %}<td>N</td>{% endif %}</tr>
      <tr><td>17.7</td><td>7.5</td><td>56</td>{%- if show_uk %}<td>O</td>{% endif %}</tr>
      <tr><td>18.1</td><td>8</td><td>57</td>{%- if show_uk %}<td>P</td>{% endif %}</tr>
      <tr><td>18.5</td><td>8.5</td><td>58</td>{%- if show_uk %}<td>Q</td>{% endif %}</tr>
      <tr><td>18.9</td><td>9</td><td>59</td>{%- if show_uk %}<td>R</td>{% endif %}</tr>
      <tr><td>19.4</td><td>9.5</td><td>61</td>{%- if show_uk %}<td>S</td>{% endif %}</tr>
      <tr><td>19.8</td><td>10</td><td>62</td>{%- if show_uk %}<td>T</td>{% endif %}</tr>
      <tr><td>20.2</td><td>10.5</td><td>63</td>{%- if show_uk %}<td>U</td>{% endif %}</tr>
      <tr><td>20.6</td><td>11</td><td>65</td>{%- if show_uk %}<td>V</td>{% endif %}</tr>
      <tr><td>21.0</td><td>11.5</td><td>66</td>{%- if show_uk %}<td>W</td>{% endif %}</tr>
      <tr><td>21.4</td><td>12</td><td>67</td>{%- if show_uk %}<td>X</td>{% endif %}</tr>
    </tbody>
  </table>

  <div class="size-guide-instructions">
    <h4>How to Measure Your Ring Size at Home</h4>
    <p>Follow these simple steps to find your perfect fit:</p>
    <ol>
      <li>Take a ring that currently fits the intended finger comfortably.</li>
      <li>Place the ring flat on a piece of white paper.</li>
      <li><span>Using a very sharp pencil or a fine-tip pen, carefully trace the <strong>inside</strong> circumference of the ring to draw a circle.</span></li>
      <li><span>Take a ruler and measure the diameter of the drawn circle (the straight line perfectly across the center, from one inner edge to the other) in <strong>millimeters (mm)</strong>.</span></li>
      <li><span>Match your measurement to the "Inside Diameter (mm)" column in the table above to find your correct {% if show_uk %}UK{% else %}US{% endif %} size.</span></li>
    </ol>
    <p class="tip"><em>Tip: If your measurement falls exactly between two sizes on the chart, we recommend ordering the larger size for a more comfortable fit.</em></p>
  </div>
</div>