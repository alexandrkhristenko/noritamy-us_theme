{% doc %}
  Displays a location-based popup for Israeli users on the US site.
  Suggests redirecting to the Israeli site.
{% enddoc %}
{% stylesheet %}
  /* Ваш CSS код без изменений */
  .country-popup { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 99999999999; align-items: center; justify-content: center; }
  .country-popup[open] { display: flex; }
  .country-popup__overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5); }
  .country-popup__content { position: relative; background-color: #ffffff; padding: 40px; max-width: 500px; width: 90%; text-align: center; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1); z-index: 1; display: flex; flex-direction: column; align-items: center; }
  .country-popup__close { position: absolute; top: 15px; right: 15px; background: none; border: none; cursor: pointer; padding: 5px; color: #1a1a1a; display: flex; align-items: center; justify-content: center; }
  .country-popup__close:hover { opacity: 0.7; }
  .country-popup__flag { margin-bottom: 20px; }
  .country-popup__flag svg { border: 1px solid #e0e0e0; width: 32px; height: 32px; }
  .country-popup__title { margin: 0 0 15px 0; font-size: 24px; font-weight: 400; color: #1a1a1a; }
  .country-popup__text { margin: 0 0 30px 0; font-size: 16px; color: #4a4a4a; line-height: 1.5; }
  .country-popup__actions { display: flex; flex-direction: column; gap: 15px; width: 100%; }
  .country-popup__btn { display: flex; align-items: center; justify-content: center; width: 100%; padding: 15px 20px; font-size: 16px; font-family: inherit; cursor: pointer; text-decoration: none; transition: all 0.2s ease; letter-spacing: 1px; }
  .country-popup__btn--primary { background-color: #1a1a1a; color: #ffffff; border: 1px solid #1a1a1a; }
  .country-popup__btn--primary:hover { background-color: #333333; border-color: #333333; color: #ffffff; }
  .country-popup__btn--secondary { background-color: transparent; color: #1a1a1a; border: 1px solid #1a1a1a; }
  .country-popup__btn--secondary:hover { background-color: #f5f5f5; }
{% endstylesheet %}

<link rel="stylesheet" href="{{ 'country-popup.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="{{ 'country-popup.css' | asset_url }}"></noscript>
<script src="{{ 'country-popup.js' | asset_url }}"></script>

<!-- ДОБАВЛЕН АТРИБУТ data-target-country="IL" -->
<country-popup class="country-popup" data-target-country="IL" data-target-url="https://www.noritamy.co.il{{ request.path }}{{ request.search }}">
  <div class="country-popup__overlay" id="country-popup-overlay"></div>
  <div class="country-popup__content" role="dialog" aria-modal="true" aria-labelledby="country-popup-title">
    <button type="button" class="country-popup__close" aria-label="{{ 'accessibility.close' | t | default: 'Close' }}">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <div style="width: 32px; height: 32px;" class="country-popup__flag">
      <?xml version="1.0" encoding="utf-8"?><svg version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" viewBox="0 0 122.88 85.48" style="enable-background:new 0 0 122.88 85.48" xml:space="preserve"><style type="text/css"><![CDATA[.st0{fill:#0038B8;}.st1{fill-rule:evenodd;clip-rule:evenodd;fill:#FFFFFF;}]]></style><g><path class="st1" d="M6.75,0h109.37c3.71,0,6.75,3.04,6.75,6.75v71.98c0,3.71-3.04,6.75-6.75,6.75H6.75C3.04,85.48,0,82.44,0,78.73 V6.75C0,3.04,3.04,0,6.75,0L6.75,0z"/><path class="st0" d="M6.71,0h109.46c3.7,0.02,6.71,3.05,6.71,6.75v9.7H0v-9.7C0,3.05,3.01,0.02,6.71,0L6.71,0z M122.88,69.05v9.68 c0,3.7-3.02,6.73-6.71,6.75H6.71C3.01,85.46,0,82.43,0,78.73v-9.68H122.88L122.88,69.05z"/><path class="st0" d="M61.44,27.19L47.96,50.53h26.96L61.44,27.19L61.44,27.19L61.44,27.19z M43.29,51.45l18.15-31.46l19.73,34.16 H41.71L43.29,51.45L43.29,51.45L43.29,51.45z"/><path class="st0" d="M61.44,58.31l13.48-23.34H47.96L61.44,58.31L61.44,58.31L61.44,58.31z M79.6,34.06L61.44,65.52L41.71,31.36 h39.43L79.6,34.06L79.6,34.06L79.6,34.06z"/></g></svg>  
    </div>

    <h2 id="country-popup-title" class="country-popup__title" dir="rtl">שמנו לב שאת מישראל</h2>
    <p class="country-popup__text" dir="rtl">בכדי להמשיך ברכישה נא לעבור לאתר הישראלי</p>

    <div class="country-popup__actions">
      <a href="https://www.noritamy.co.il{{ request.path }}{{ request.search }}" class="country-popup__btn country-popup__btn--primary" id="country-popup-switch" dir="rtl">עברי לאתר הישראלי</a>
      <button type="button" class="country-popup__btn country-popup__btn--secondary" id="country-popup-dismiss" dir="rtl">לא תודה</button>
    </div>
  </div>
</country-popup>
