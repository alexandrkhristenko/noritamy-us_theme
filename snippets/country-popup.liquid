{% doc %}
  Displays a location-based popup for Israeli users on the US site.
  Suggests redirecting to the Israeli site.
{% enddoc %}
{% stylesheet %}
  .country-popup {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 99999999999;
    align-items: center;
    justify-content: center;
  }
  .country-popup[open] { display: flex; }

  .country-popup__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(20, 18, 16, 0.38);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .country-popup__content {
    position: relative;
    z-index: 1;
    background-color: #ffffff;
    padding: 44px 40px 34px;
    max-width: 440px;
    width: 90%;
    text-align: center;
    box-shadow: 0 24px 70px rgba(20, 18, 16, 0.22);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .country-popup__close {
    position: absolute;
    top: 16px;
    inset-inline-start: 16px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    color: #1e1f21;
    opacity: 0.5;
    display: flex;
    transition: opacity 0.2s ease;
  }
  .country-popup__close:hover { opacity: 1; }

  .country-popup__flag {
    width: 28px;
    height: 20px;
    border-radius: 0;
    overflow: hidden;
    box-shadow: 0 5px 16px rgba(20, 18, 16, 0.16);
    margin: 0 0 24px;
  }
  .country-popup__flag svg { display: block; width: 100%; height: 100%; }

  .country-popup__title {
    font-family: 'Assistant', 'Heebo', 'Segoe UI', system-ui, sans-serif;
    margin: 0 0 12px;
    font-size: 22px;
    font-weight: 600;
    color: #1e1f21;
    line-height: 1.35;
  }

  .country-popup__text {
    font-family: 'Assistant', 'Heebo', 'Segoe UI', system-ui, sans-serif;
    margin: 0 0 28px;
    font-size: 15px;
    font-weight: 400;
    color: #6b635c;
    line-height: 1.7;
    max-width: 360px;
  }

  .country-popup__actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    align-items: center;
  }

  .country-popup__btn--primary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: auto;
    padding: 12px 26px;
    font-family: 'Assistant', 'Heebo', 'Segoe UI', system-ui, sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: #ffffff;
    background-color: #1e1f21;
    border: 1px solid #1e1f21;
    border-radius: 0;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }
  .country-popup__btn--primary:hover {
    background-color: #54352e;
    border-color: #54352e;
    color: #ffffff;
  }
  .country-popup__btn--primary svg { width: 16px; height: 16px; flex-shrink: 0; }

  .country-popup__btn--secondary {
    background: none;
    border: none;
    cursor: pointer;
    font-family: 'Assistant', 'Heebo', 'Segoe UI', system-ui, sans-serif;
    font-size: 13.5px;
    color: #57534e;
    text-decoration: underline;
    text-underline-offset: 3px;
    padding: 6px;
    margin-top: 2px;
    transition: color 0.2s ease;
  }
  .country-popup__btn--secondary:hover { color: #1e1f21; }
{% endstylesheet %}

<link rel="stylesheet" href="{{ 'country-popup.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="{{ 'country-popup.css' | asset_url }}"></noscript>
<script src="{{ 'country-popup.js' | asset_url }}" defer="defer"></script>

<country-popup class="country-popup" data-target-country="IL" data-target-url="https://www.noritamy.co.il{{ request.path }}{{ request.search }}">
  <div class="country-popup__overlay"></div>
  <div class="country-popup__content" role="dialog" aria-modal="true" aria-labelledby="country-popup-title" dir="rtl">
    <button type="button" class="country-popup__close" aria-label="{{ 'accessibility.close' | t | default: 'Close' }}">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <div class="country-popup__flag" aria-hidden="true">
      <svg viewBox="0 0 122.88 85.48" xmlns="http://www.w3.org/2000/svg">
        <path fill="#ffffff" d="M6.75,0h109.37c3.71,0,6.75,3.04,6.75,6.75v71.98c0,3.71-3.04,6.75-6.75,6.75H6.75C3.04,85.48,0,82.44,0,78.73 V6.75C0,3.04,3.04,0,6.75,0L6.75,0z"/>
        <path fill="#0038B8" d="M6.71,0h109.46c3.7,0.02,6.71,3.05,6.71,6.75v9.7H0v-9.7C0,3.05,3.01,0.02,6.71,0L6.71,0z M122.88,69.05v9.68 c0,3.7-3.02,6.73-6.71,6.75H6.71C3.01,85.46,0,82.43,0,78.73v-9.68H122.88L122.88,69.05z"/>
        <path fill="#0038B8" d="M61.44,27.19L47.96,50.53h26.96L61.44,27.19L61.44,27.19L61.44,27.19z M43.29,51.45l18.15-31.46l19.73,34.16 H41.71L43.29,51.45L43.29,51.45L43.29,51.45z"/>
        <path fill="#0038B8" d="M61.44,58.31l13.48-23.34H47.96L61.44,58.31L61.44,58.31L61.44,58.31z M79.6,34.06L61.44,65.52L41.71,31.36 h39.43L79.6,34.06L79.6,34.06L79.6,34.06z"/>
      </svg>
    </div>

    <h2 id="country-popup-title" class="country-popup__title">שמנו לב שאת מישראל</h2>
    <p class="country-popup__text">אנו ממליצים לך לגלוש באתר הישראלי שלנו לחוויית קנייה בעברית, במטבע מקומי ובמגוון אפשרויות לאיסוף עצמי או משלוח עד הבית</p>

    <div class="country-popup__actions">
      <a href="https://www.noritamy.co.il{{ request.path }}{{ request.search }}" class="country-popup__btn country-popup__btn--primary" id="country-popup-switch">
        <span>עברי לאתר הישראלי</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M19 12H5M12 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <button type="button" class="country-popup__btn country-popup__btn--secondary" id="country-popup-dismiss">לא תודה, אמשיך באתר האמריקאי</button>
    </div>
  </div>
</country-popup>
