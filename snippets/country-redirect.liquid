<script>
  (function() {
    var search = window.location.search;

    if (search.indexOf('no_redirect=true') > -1) {
      document.cookie = "no_redirect=true; path=/; max-age=2592000; SameSite=Lax";
      return;
    }

    if (document.cookie.indexOf('no_redirect=true') > -1) {
      return;
    }

    var currentHost = window.location.hostname;

    if (currentHost === 'www.noritamy.com' || currentHost === 'noritamy.com') {
      var country = {{ localization.country.iso_code | json }};

      if (country === 'IL') {
        var currentPath = window.location.pathname;
        var newUrl = 'https://www.noritamy.co.il' + currentPath + search;
        window.location.replace(newUrl);
      }
      // Для всех остальных стран скрипт просто завершает работу,
      // и пользователь/поисковик остается на .com
    }
  })();
</script>
