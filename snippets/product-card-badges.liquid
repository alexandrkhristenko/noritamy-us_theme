{%- doc -%}
  Renders a single product badge — highest priority only.
  Precedence: SALE > NEW > BEST SELLER > custom label_ tag
  SALE badge: shows inline savings % in the same row.
  Visual: frosted glass (white, backdrop-filter), ink text, 0px radius.

  @param {object} product - The product object.
  @param {object} settings - The theme settings object.
{%- enddoc -%}

{%- liquid
  assign badge = blank
  assign badge_label = blank
  assign saved_pct = 0

  if product.compare_at_price_max > product.price
    assign badge = 'sale'
    assign saved_pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
  else
    unless collection.handle == 'new' or collection.handle == 'new-1'
      for col in product.collections
        if col.handle == 'new' or col.handle == 'new-1'
          assign badge = 'new'
          break
        endif
      endfor
    endunless

    if badge == blank
      unless collection.handle contains 'best-seller' or collection.handle contains 'bestseller'
        for col in product.collections
          if col.handle contains 'best-seller' or col.handle contains 'bestseller'
            assign badge = 'best-seller'
            break
          endif
        endfor
      endunless
    endif

    if badge == blank
      for tag in product.tags
        if tag contains 'label_'
          assign badge = 'custom'
          assign badge_label = tag | split: 'label_' | last
          break
        endif
      endfor
    endif
  endif
-%}

{%- if badge != blank -%}
  <div
    class="product-badges product-badges--{{ settings.badge_position }}"
    style="--badge-border-radius: 0px;"
  >
    {%- if badge == 'sale' -%}
      <div class="noritamy-badge-row">
        <span class="noritamy-badge">SALE</span>
        {%- if saved_pct > 0 -%}
          <span class="noritamy-badge noritamy-badge--savings">Save {{ saved_pct }}%</span>
        {%- endif -%}
      </div>
    {%- else -%}
      <span class="noritamy-badge">
        {%- case badge -%}
          {%- when 'new' -%}NEW
          {%- when 'best-seller' -%}BEST SELLER
          {%- when 'custom' -%}{{ badge_label }}
        {%- endcase -%}
      </span>
    {%- endif -%}
  </div>
{%- endif -%}

{%- if settings.product_card_strip_text != blank -%}
  <div class="product-badges__strip">
    {{ settings.product_card_strip_text }}
  </div>
{%- endif -%}

<style>
  .product-badges {
    position: absolute;
    /* Force physical top-left regardless of admin badge_position or RTL rules.
       width: max-content prevents the container from stretching when both
       left and right are set by the RTL stylesheet simultaneously. */
    top: 6px !important;
    left: 6px !important;
    right: auto !important;
    bottom: auto !important;
    width: max-content !important;
    align-items: flex-start;
    z-index: var(--layer-raised);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* Keep z-index raised on hover so quick-add doesn't clip the badge */
  .product-card:hover .product-badges {
    z-index: var(--layer-raised);
  }

  .noritamy-badge-row {
    display: flex;
    flex-direction: row;
    /* Force LTR so SALE appears on the left even on an RTL page */
    direction: ltr;
    gap: 3px;
    align-items: center;
    flex-wrap: nowrap;
  }

  /* Frosted glass badge — modern, readable over any photo */
  .noritamy-badge {
    display: inline-flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.88) !important;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: #1e1f21 !important;
    font-family: 'Rubik', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 4px 7px;
    border-radius: 0;
    line-height: 1;
    white-space: nowrap;
  }

  /* Savings percentage: warm rust to differentiate from the SALE label */
  .noritamy-badge--savings {
    color: #7d5449 !important;
  }

  .product-badges__strip {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    background: rgba(255, 255, 255, 0.88);
    color: #1e1f21;
    text-align: center;
    padding: 6px 10px;
    font-size: 10px;
    font-weight: 600;
    font-family: 'Rubik', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    z-index: var(--layer-flat);
    backdrop-filter: blur(4px);
  }
</style>
