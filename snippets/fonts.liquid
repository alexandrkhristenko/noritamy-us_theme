{%- unless settings.type_body_font.system?
  and settings.type_subheading_font.system?
  and settings.type_heading_font.system?
-%}
  <link
    rel="preconnect"
    href="https://fonts.shopifycdn.com"
    crossorigin
  >
{%- endunless -%}

{% if request.locale.iso_code == 'he' %}
  {% # Preload the most important font files %}
  {{ 'noto-sans-hebrew-v50-latin-regular.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ 'noto-sans-hebrew-v50-latin-500.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ 'noto-sans-hebrew-v50-latin-700.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  <style>
    @font-face {
      font-family: 'Noto Sans Hebrew';
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url('{{ "noto-sans-hebrew-v50-latin-regular.woff2" | asset_url }}') format('woff2');
    }
    @font-face {
      font-family: 'Noto Sans Hebrew';
      font-style: normal;
      font-weight: 500;
      font-display: swap;
      src: url('{{ "noto-sans-hebrew-v50-latin-500.woff2" | asset_url }}') format('woff2');
    }
    @font-face {
      font-family: 'Noto Sans Hebrew';
      font-style: normal;
      font-weight: 700;
      font-display: swap;
      src: url('{{ "noto-sans-hebrew-v50-latin-700.woff2" | asset_url }}') format('woff2');
    }
  </style>
{% endif %}

{{ 'rubik-v31-latin-regular.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
<style>
  @font-face {
    font-family: 'Rubik';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('{{ "rubik-v31-latin-regular.woff2" | asset_url }}') format('woff2');
  }
</style>

{% # theme-check-disable %}
{%- comment -%}
  Body, subheading and accent often share one file (here: Montserrat 500 three times), so
  preload each distinct URL once.
{%- endcomment -%}
{%- liquid
  assign preloaded_font_urls = ''
-%}
{%- for font in (1..4) -%}
  {%- case forloop.index -%}
    {%- when 1 -%}{%- assign preload_font = settings.type_body_font -%}
    {%- when 2 -%}{%- assign preload_font = settings.type_subheading_font -%}
    {%- when 3 -%}{%- assign preload_font = settings.type_heading_font -%}
    {%- when 4 -%}{%- assign preload_font = settings.type_accent_font -%}
  {%- endcase -%}
  {%- unless preload_font.system? -%}
    {%- assign preload_font_url = preload_font | font_url -%}
    {%- unless preloaded_font_urls contains preload_font_url -%}
      <link
        rel="preload"
        as="font"
        href="{{ preload_font_url }}"
        type="font/woff2"
        crossorigin
      >
      {%- assign preloaded_font_urls = preloaded_font_urls | append: preload_font_url | append: ' ' -%}
    {%- endunless -%}
  {%- endunless -%}
{%- endfor -%}
{% # theme-check-enable %}

{%- render 'fonts-he-override' -%}
