{%- doc -%}
  Gift with purchase (Theme settings → Gift with purchase): config and script. The script also
  runs while the feature is switched off whenever the cart still holds a tagged gift line, so
  those lines are cleaned up instead of being charged once the discount is gone.

  @param {boolean} [standalone] - Rendered outside the theme layout (Shopeaks pages): the script
    watches the page's own cart requests instead of theme cart events.
{%- enddoc -%}
{% liquid
  assign gwp_enabled = settings.gift_with_purchase_enabled
  assign gwp_variant = null
  if settings.gift_with_purchase_product != blank
    assign gwp_variant = settings.gift_with_purchase_product.selected_or_first_available_variant
    assign gwp_variant_id_setting = settings.gift_with_purchase_variant_id | strip
    if gwp_variant_id_setting != blank
      for variant in settings.gift_with_purchase_product.variants
        assign variant_id_string = variant.id | append: ''
        if variant_id_string == gwp_variant_id_setting
          assign gwp_variant = variant
          break
        endif
      endfor
    endif
  endif

  assign gwp_gift_lines = 0
  assign gwp_gift_quantity = 0
  assign gwp_other_lines = 0
  assign gwp_foreign_gift = false
  assign gwp_variant_discount = 0
  assign gwp_variant_unit_price = 0
  for item in cart.items
    if gwp_variant and item.variant_id == gwp_variant.id
      assign gwp_line_discount = item.original_line_price | minus: item.final_line_price
      assign gwp_variant_discount = gwp_variant_discount | plus: gwp_line_discount
      assign gwp_variant_unit_price = item.original_price
    endif
    if item.properties._gift_with_purchase == '1'
      assign gwp_gift_lines = gwp_gift_lines | plus: 1
      assign gwp_gift_quantity = gwp_gift_quantity | plus: item.quantity
      if gwp_variant == null or item.variant_id != gwp_variant.id
        assign gwp_foreign_gift = true
      endif
    else
      assign gwp_other_lines = gwp_other_lines | plus: 1
    endif
  endfor

  assign gwp_active = false
  if gwp_enabled and gwp_variant != null and gwp_variant.available
    assign gwp_active = true
  endif

  assign gwp_needs_sync = false
  if gwp_active
    if gwp_other_lines > 0 and gwp_gift_lines == 0
      assign gwp_needs_sync = true
    elsif gwp_other_lines == 0 and gwp_gift_lines > 0
      assign gwp_needs_sync = true
    elsif gwp_gift_lines > 1 or gwp_gift_quantity > gwp_gift_lines or gwp_foreign_gift
      assign gwp_needs_sync = true
    elsif gwp_gift_lines > 0 and gwp_variant_discount < gwp_variant_unit_price
      # The gift is in the cart but not free (discount ended or missing).
      assign gwp_needs_sync = true
    endif
  elsif gwp_gift_lines > 0
    assign gwp_needs_sync = true
  endif
%}
{% if gwp_active or gwp_gift_lines > 0 %}
  <script type="application/json" id="gift-with-purchase-config">
    {
      "enabled": {{ gwp_active | json }},
      "variantId": {% if gwp_variant %}{{ gwp_variant.id | json }}{% else %}null{% endif %},
      "available": {% if gwp_variant %}{{ gwp_variant.available | json }}{% else %}false{% endif %},
      "needsSync": {{ gwp_needs_sync | json }},
      "standalone": {% if standalone %}true{% else %}false{% endif %},
      "badge": {{ settings.gift_with_purchase_badge | strip | json }},
      "productTitle": {% if gwp_variant %}{{ gwp_variant.product.title | json }}{% else %}null{% endif %},
      "routes": {
        "cart": {{ routes.cart_url | json }},
        "add": {{ routes.cart_add_url | append: '.js' | json }},
        "change": {{ routes.cart_change_url | append: '.js' | json }}
      }
    }
  </script>
  <script
    src="{{ 'gift-with-purchase.js' | asset_url }}"
    type="module"
  ></script>
{% endif %}
