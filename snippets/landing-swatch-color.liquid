{%- doc -%}
  Outputs a JSON string holding the CSS background for a material swatch on the landing page.

  Uses the colour set on the option value in Shopify when there is one. Otherwise it falls back to the
  material name, because the Initials products have no swatch colours configured.

  @param {string} [name] - Material name, e.g. "Gold-plated", "Sterling silver 925", "Half And Half"
  @param {object} [swatch] - The option value's swatch drop
{%- enddoc -%}

{%- liquid
  assign material_name = name | default: '' | downcase
  assign background = '#D9D9D9'
  if swatch.color
    assign background = 'rgb(' | append: swatch.color.rgb | append: ')'
  elsif material_name contains 'half'
    assign background = 'linear-gradient(90deg, #C8A24E 50%, #C7C9CC 50%)'
  elsif material_name contains 'rose'
    assign background = '#D9A28C'
  elsif material_name contains 'gold'
    assign background = '#C8A24E'
  elsif material_name contains 'silver'
    assign background = '#C7C9CC'
  elsif material_name contains 'brass'
    assign background = '#B58B3A'
  endif
-%}
{{- background | json -}}
