{% comment %}
  Landing page feature: one photo with a title and a short text, e.g. the packaging.
  Stacked on mobile, split in two from 750px.
{% endcomment %}

{{ 'section-landing.css' | asset_url | stylesheet_tag }}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--full-width color-{{ section.settings.color_scheme }}">
  <div class="landing-feature">
    <div class="landing-feature__media">
      {%- render 'landing-image',
        image: section.settings.image,
        product: section.settings.image_product,
        media_index: section.settings.image_product_media,
        sizes: '(min-width: 750px) 50vw, 100vw',
        class: 'landing-feature__image'
      -%}
    </div>
    <div class="landing-feature__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="h4">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="landing-feature__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Landing feature",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "In our signature packaging"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave empty to use a product photo instead."
    },
    {
      "type": "product",
      "id": "image_product",
      "label": "Product photo to use"
    },
    {
      "type": "range",
      "id": "image_product_media",
      "label": "Which photo of the product",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 1
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Landing feature"
    }
  ]
}
{% endschema %}
