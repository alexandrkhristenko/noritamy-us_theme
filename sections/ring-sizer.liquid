 * guessed, because a frame of unknown width is the one case the scale cannot survive, and it
 * has to be asserted BEFORE detectScreen() runs.
 */
/**
 * A same-origin path, or nothing.
 *
 * Two of these parameters end up in an href and in location.href. A query string on the CDN
 * copy is attacker-controllable, so "javascript:..." or a quote that closes the attribute has
 * to be impossible rather than unlikely. One leading slash, no scheme, no protocol-relative
 * "//host", and no characters that can break out of an attribute.
 */
function samePath(v) {
  if (typeof v !== "string") return null;
  if (!/^\/[^\/\\]/.test(v)) return null;
  return /["'<>\s]/.test(v) ? null : v;
}

const EMBEDDED = /[?&]embedded=1/.test(location.search);
if (EMBEDDED) trustFramedViewport(true);

/**
 * Configuration by query string, for the copy that runs as a static theme asset.
 *
 * Shopify answers every storefront page with `frame-ancestors 'none'`, so a page cannot be
 * framed even by itself. A theme asset on the CDN can be, which is how the product modal gets
 * an isolated copy, and a static file has no Liquid to inject the store's own values.
 */
{
  const q = new URLSearchParams(location.search);
  for (const [param, global] of [["store", "RING_SIZER_STORE"], ["wa", "RING_SIZER_WHATSAPP"],
                                 ["shop", "RING_SIZER_SHOP_URL"], ["policy", "RING_SIZER_POLICY_URL"],
                                 ["cc", "RING_SIZER_COUNTRY"], ["nolang", "RING_SIZER_NOLANG"]]) {
    const v = param === "store" || param === "wa" || param === "cc" || param === "nolang" ? q.get(param) : samePath(q.get(param));
    if (v && window[global] === undefined) window[global] = v;
  }
  // The screen, as seen by the page that framed us. See overrideScreenGeometry: a frame can be
  // blind to the device it is running on, and this is the one number nothing else can replace.
  if (EMBEDDED && q.get("sw")) {
    overrideScreenGeometry({
      shortCss: Number(q.get("sw")), longCss: Number(q.get("sh")), dpr: Number(q.get("dpr")),
    });
    // And the parent's own layout width, so the zoom test compares like with like.
    if (q.get("lw")) overrideLayoutWidth(Number(q.get("lw")));
  }
}

