let LANG = "en";
const t = (k) => T[k][LANG];

/* ---------- state ------------------------------------------------------ */
const detected = detectScreen();
/**
 * Two scales, deliberately.
 *
 * `basePxPerMm` is css pixels per millimetre at pinch-zoom 1. `pxPerMm` is what to draw with
 * right now. Pinch zoom does not change the CSS pixel count, it magnifies each pixel, so at
 * scale s one css pixel covers s times more glass and the drawing scale is base/s. Deriving it
 * live means a customer can pinch to look closer and the circle stays physically correct,
 * instead of being warned that the calibration is void. Page zoom is already cancelled inside
 * cssAcrossScreen, so the base itself is zoom-free and safe to store.
 */
let basePxPerMm = detected.pxPerMm;
let pxPerMm = basePxPerMm;
let innerMm = 0;
let source = "detected";
let method = "device";
let coin = COINS[CAT.region][0];
let devLabel = "";
// The physical screen width the drawing is currently based on, in millimetres. Held rather than
// re-derived: dividing a screen width by a scale is only valid when both were measured in the
// same coordinate space, and inside the product modal they are not.
let devWidthMm = detected.widthMm;

const vvScale = () => (window.visualViewport ? window.visualViewport.scale : 1);

function syncScale() { pxPerMm = basePxPerMm / vvScale(); }

function loadSaved() {
  try {
    const s = JSON.parse(localStorage.getItem(STORE_KEY) || "null");
    // The stored value is a zoom-free base, so it survives any zoom the customer was using.
    if (!s || s.key !== detected.key || s.dpr !== detected.dpr) return null;
    return s;
  } catch { return null; }
}
function save() {
  try {
    localStorage.setItem(STORE_KEY, JSON.stringify({
      pxPerMm: basePxPerMm, key: detected.key, dpr: detected.dpr,
    }));
  } catch { /* private browsing */ }
}

/* ---------- step 1: calibration --------------------------------------- */
const CARD_TOP = 10;
const calStage = $("cal-stage"), card = $("card"), coinEl = $("coin"), devnote = $("devnote");
const gTop = $("g-top"), gBot = $("g-bot"), calRange = $("cal-range");

const referenceMm = () => (method === "coin" ? coin.mm : CARD.shortMm);

function calBounds() {
  // Absolute floor and ceiling, not proportional to what fits: a small coin leaves room to
  // draw 14 px/mm, and scaling the minimum with it would put every real phone below the
  // bottom of its own slider. Real screens run about 3.6 to 6.5 px/mm.
  // clientHeight is 0 while the step is hidden, which would make max negative.
  const h = calStage.clientHeight;
  if (h <= 0) return { min: 3.0, max: 9.0 };
  return { min: 3.0, max: Math.min((h - 18) / referenceMm(), 9.0) };
}

/** 0.3mm of rim, held constant in millimetres so the judgement is the same on every screen. */
function applyRim() {
  // The black ring's thickness is the tolerance on the too-big side, since it has to be
  // covered completely before the pale blue reaches the metal. Kept modest for that reason,
  // and it no longer has to be thick to be seen: black on gold needs no help.
  document.documentElement.style.setProperty(
    "--rim", Math.max(1.6, 0.26 * pxPerMm).toFixed(2) + "px");
}

function drawCard() {
  const hPx = CARD.shortMm * pxPerMm;
  const trueW = CARD.longMm * pxPerMm;
  const drawW = Math.min(trueW, calStage.clientWidth);
  card.style.height = hPx + "px";
  card.style.width = drawW + "px";
  card.classList.toggle("clipped", drawW < trueW - 1);
  card.style.marginBottom = Math.max(0, calStage.clientHeight - hPx - CARD_TOP * 2) + "px";
  gTop.style.top = CARD_TOP + "px";
  gBot.style.top = CARD_TOP + hPx + "px";
}

function drawCal() {
  applyRim();
  card.hidden = method !== "card";
  coinEl.hidden = method !== "coin";
  devnote.hidden = method !== "device";
  gTop.hidden = gBot.hidden = method !== "card";
  if (method === "coin") {
    const px = coin.mm * pxPerMm;
    coinEl.style.width = px + "px"; coinEl.style.height = px + "px";
  } else if (method === "card") {
    drawCard();
  } else {
    // Nothing to match against here, so the stage reports the outcome instead of showing a
    // picture of a card the customer is not being asked to use.
    // Auto-detection knew the model all along and never said so, which left the only screen
    // in the flow showing a blank stage and a grey instruction. Name it, and the customer's
    // job drops to confirming or correcting.
    const known = notListed
      ? "" : devLabel || (detected.matched && !detected.ambiguous ? detected.label : "");
    devnote.innerHTML = "<div class='phone-glyph'></div>" + (notListed
      ? "<b>" + t("notListedTitle") + "</b><span>" + t("notListedBody") + "</span>"
      : known
      // devWidthMm, NOT shortCss / pxPerMm. That division mixes the screen width as the parent
      // measured it with a scale measured inside the frame, and in the product modal it told an
      // iPhone 16 owner their 65.1mm screen was 68.6mm wide. This is the width actually in use.
      ? "<i class='lead'>" + t("devIs") + "</i><b>" + known + "</b><span>" + t("devWide") +
        devWidthMm.toFixed(1) + t("mmUnit") + "</span>" +
        "<em>" + t("devNot") + "</em>" +
        // Only offered while the card method exists. Without this it was a link into a
        // method whose tab is gone, with no way back out of it.
        (FEATURES.card ? "<u id='dev-verify'>" + t("devVerify") + "</u>" : "")
      : "<span>" + t("devPrompt") + "</span>");
  }
  document.documentElement.dataset.pxPerMm = pxPerMm.toFixed(4);
}

function setMethod(next) {
  method = next;
  document.querySelectorAll("[data-method]").forEach((b) =>
    b.setAttribute("aria-pressed", String(b.dataset.method === next)));
  $("cal-sub").textContent = t(next === "card" ? "subCard" : next === "coin" ? "subCoin" : "subDevice");
  $("coin-pick").hidden = next !== "coin";
  $("device-pick").hidden = next !== "device";
  $("inch-pick").hidden = next !== "device" || !FEATURES.inch;
  $("cal-row").hidden = next === "device";
  initCal();
}

function initCal() {
  const b = calBounds();
  calRange.min = b.min; calRange.max = b.max;
  // The slider range is a display limit, not the truth. Clamping pxPerMm here would quietly
  // destroy a correct calibration when switching to a method this screen cannot draw.
  calRange.value = Math.min(Math.max(pxPerMm, b.min), b.max);
  drawCal();

  const banner = $("cal-banner");
  // Page zoom and a narrow window look identical from here and want opposite handling, so a
  // mismatch means the picker's answer cannot be trusted. The card does not care either way.
  const mism = layoutMismatch();
  // Not when the device was identified BY its layout width: then the gap between layout and
  // reported screen is exactly what named the phone, and calling it browser zoom sent a
  // correctly measured iPhone 16 a warning telling it to reset a zoom it never had.
  const zoomSuspect = detected.basis !== "layout" && mism !== null && Math.abs(mism - 1) > 0.02;

  /**
   * A manual pick that contradicts a confident detection.
   *
   * This is the one error that reached real customers. The screen said 68.9mm and the customer
   * picked a 65.1mm model, and the tool simply believed the customer: every millimetre came out
   * 5.8% large and a real EU 51 ring read as 48. Detection is usually the better witness, since
   * it comes from the device, but not always (Display Zoom makes it report a narrower screen
   * than the glass), so this warns rather than refuses and names the check that settles it.
   */
  const clash = devLabel && detected.matched && !detected.ambiguous
    ? devWidthMm / detected.widthMm - 1 : 0;
  if (method === "device" && Math.abs(clash) > 0.02) {
    // Expressed in sizes, because millimetres of glass mean nothing to the person reading it.
    // One EU size is 1mm of circumference, one US size is 0.8128mm of diameter.
    const sizes = Math.abs(clash) * (CAT.scale === "EU" ? Math.PI * 16.5 : 16.5 / US_PER_MM);
    banner.hidden = false;
    banner.textContent = t("pickClash")
      .replace("{det}", detected.widthMm.toFixed(1))
      .replace("{pick}", devWidthMm.toFixed(1))
      .replace("{n}", sizes < 1.5 ? "1" : String(Math.round(sizes)));
  } else if (method === "device" && zoomSuspect) {
    banner.hidden = false;
    banner.textContent = t("zoomSuspect");
  } else if (method !== "device" && b.max < DENSEST_PHONE) {
    banner.hidden = false;
    banner.textContent = t("tooShort");
  } else if (detected.ambiguous && source === "detected") {
    banner.hidden = false;
    banner.textContent = t(detected.matched ? "ambiguous" : "unknownDev");
  } else banner.hidden = true;

  // Nothing may proceed on a guess. Detection covers iPhones by geometry and no Android at
  // all, so before this the common Android path was: press Continue, silently inherit the
  // 64.6mm fallback, and be told a size derived from a screen width nobody ever checked. A
  // Galaxy S24 Ultra is 71mm, which is 9% out, which is two US sizes. The ambiguous iPhone
  // geometry (X/XS/11 Pro against 12/13 mini, 8% apart) had the same hole.
  const mustChoose = method === "device" &&
    (notListed || (!devLabel && (!detected.matched || detected.ambiguous || zoomSuspect)));
  $("cal-next").disabled = mustChoose;
  $("cal-next").style.opacity = mustChoose ? ".4" : "1";

  // The message carries the screen's own geometry, so whoever answers can look the model up
  // and reply with a width instead of starting the conversation with "what phone is it".
  const wa = $("cal-wa"), waNum = String(window.RING_SIZER_WHATSAPP || "").replace(/[^0-9]/g, "");
  wa.hidden = !mustChoose || !waNum;
  // Once she has said the phone is not there, this IS the next step, so it stops looking like
  // a footnote under a dead button and starts looking like the thing to press.
  wa.classList.toggle("cta", notListed);
  wa.textContent = t(notListed ? "waGo" : "waHelp");
  if (!wa.hidden) {
    wa.href = "https://api.whatsapp.com/send?phone=" + waNum + "&text=" +
      encodeURIComponent(t("waMsg") + detected.key + " (" + location.href.split("?")[0] + ")");
  }

  $("cal-note").textContent = method === "card"
    ? (source === "detected" && detected.matched ? t("startingFrom") + detected.label : t("noteCard"))
    : method === "coin" ? t("noteCoin") : "";
}

document.querySelectorAll("[data-method]").forEach((b) =>
  b.addEventListener("click", () => setMethod(b.dataset.method)));
calRange.addEventListener("input", () => {
  // The customer matches what they can see, which is the zoomed drawing, so undo the zoom.
  basePxPerMm = parseFloat(calRange.value) * vvScale();
  syncScale(); source = method; devLabel = "";
  devWidthMm = cssAcrossScreen() / basePxPerMm;
  drawCal(); dumpDebug();
});
document.querySelectorAll("[data-cal]").forEach((b) => b.addEventListener("click", () => {
  const bounds = calBounds();
  const next = Math.min(bounds.max, Math.max(bounds.min, pxPerMm + 0.02 * Number(b.dataset.cal)));
  basePxPerMm = next * vvScale();
  syncScale(); calRange.value = pxPerMm; source = method;
  devWidthMm = cssAcrossScreen() / basePxPerMm;
  drawCal(); dumpDebug();
}));
calStage.addEventListener("click", (e) => {
  if (e.target.id === "dev-verify" && FEATURES.card) setMethod("card");
});

function fillPickers() {
  // Refilling happens on every language switch. Rebuilding the options discards the value, so
  // a customer who named their phone and then switched language was silently returned to the
  // auto-detected guess, with the picker still reading as though they had chosen.
  const keepDev = $("device-pick").value, keepInch = $("inch-pick").value;
  $("coin-pick").innerHTML = COINS[CAT.region]
    .map((c, i) => "<option value='" + i + "'>" + c.label + " (" + c.mm + " mm)</option>").join("");
  coin = COINS[CAT.region][0];
  // Grouped so a long list stays navigable, and any unlisted phone falls through to a diagonal.
  const groups = [...new Set(DEVICE_PICKER.map((d) => d.group))];
  // The way out belongs among the choices, not beside them: someone scrolling a list looking
  // for a phone that is not in it should reach the end of the list and find the answer there.
  $("device-pick").innerHTML = "<option value=''>" + t("pickPhone") + "</option>" +
    groups.map((g) => "<optgroup label='" + g + "'>" +
      DEVICE_PICKER.map((d, i) => d.group === g
        ? "<option value='" + i + "'>" + d.label + "</option>" : "").join("") +
      "</optgroup>").join("") +
    "<option value='none'>" + t("notListed") + "</option>";
  $("inch-pick").innerHTML = "<option value=''>" + t("pickInch") + "</option>" +
    DIAGONALS.map((n) => "<option value='" + n + "'>" + n.toFixed(1) + t("inchScreen") + "</option>").join("");
  $("device-pick").value = keepDev;
  $("inch-pick").value = keepInch;
}
$("coin-pick").addEventListener("change", (e) => {
  coin = COINS[CAT.region][Number(e.target.value)]; initCal();
});

function applyWidth(widthMm, label) {
  // Derived from the live layout width, so Display Zoom and browser page zoom both land right.
  basePxPerMm = pxPerMmForWidth(widthMm);
  // initCal, not drawCal: naming the phone is what clears the "you must choose" block, and
  // only initCal re-evaluates it. Without this the customer picked their model and Continue
  // stayed greyed out, with nothing on screen saying what else it wanted.
  syncScale(); source = "device"; devLabel = label; devWidthMm = widthMm; initCal(); dumpDebug();
}
$("device-pick").addEventListener("change", (e) => {
  if (e.target.value === "") return;
  $("inch-pick").value = "";
  if (e.target.value === "none") {
    // No width is applied. Saying "not listed" must never leave a number behind that a later
    // screen would quietly draw with.
    notListed = true; devLabel = ""; source = "detected"; devWidthMm = detected.widthMm;
    initCal(); dumpDebug();
    return;
  }
  notListed = false;
  const d = DEVICE_PICKER[Number(e.target.value)];
  applyWidth(entryWidthMm(d), d.label);
});
$("inch-pick").addEventListener("change", (e) => {
  if (e.target.value === "") return;
  // Naming a screen size is naming the phone, so it has to clear "my phone is not listed" the
  // same way picking a model does. Without this Continue stayed disabled for good.
  notListed = false;
  $("device-pick").value = "";
  const inch = parseFloat(e.target.value);
  applyWidth(widthMmForInches(inch), inch.toFixed(1) + t("inchScreen"));
});
$("cal-next").addEventListener("click", () => { save(); go("s-measure"); });

/* ---------- step 2: measurement --------------------------------------- */
/**
 * One US size is 0.81mm of inner diameter, which is 4.9 css pixels. The eye resolves that
 * fine; a thumb on a slider cannot place it. So the wheel snaps to stocked sizes only, and
 * the guided path asks one visible yes/no per step and binary-searches, which is why both
 * exist and why free-form adjustment does not.
 */
const disc = $("disc"), rulerEl = $("ruler"), mStage = $("m-stage"), wheel = $("m-wheel");
let mMethod = "circle";
let sizeIdx = Math.max(0, CAT.sizes.indexOf(7));
let compareOn = false, guided = false, notListed = false;
let lo = 0, hi = CAT.sizes.length - 1, asked = 0;
let guidedResult = null;   // the size the questions arrived at, pending the customer's check
let guidedHistory = [];
let rulerMm = 0, rulerSpan = 0;
let wheelLock = false;


const RULER_MODE = {
  strip: { max: 78, unit: "mmAround", toInner: (mm) => mm / Math.PI },
  ruler: { max: 26, unit: "mmAcross", toInner: (mm) => mm },
};
const sizeAt = (i) => CAT.sizes[Math.min(CAT.sizes.length - 1, Math.max(0, i))];

function buildWheel() {
  // Sizes and two spacers. Nothing else belongs in here: the wheel is a scroll container whose
  // geometry decides which sizes the customer can reach, so any stray child moves the reachable
  // range. It once held three lines of diagnostics and the smallest stocked size sat 576px past
  // the marker, unreachable by flicking, while every screenshot looked clean because the
  // centring had already scrolled the text out of view.
  wheel.innerHTML = "<div class='wpad'></div>" +
    CAT.sizes.map((sz, i) => "<button class='wsz' data-idx='" + i + "'>" + sz + "</button>").join("") +
    "<div class='wpad'></div>";
}

/** Centre by rect maths rather than scrollLeft, which flips sign under RTL. */
function centerWheel(i, smooth, tries = 0) {
  const b = wheel.querySelector("[data-idx='" + i + "']");
  if (!b) return;
  // The step is revealed and centred in the same tick, so the first attempt lands before
  // layout has happened and the wheel measures zero. Giving up there left the wheel parked
  // at one end of its range while the readout said something else entirely: EU 52 selected,
  // "60" sitting under the marker. Wait for layout instead of abandoning the centring.
  if (wheel.clientWidth === 0) {
    if (tries < 30) requestAnimationFrame(() => centerWheel(i, smooth, tries + 1));
    return;
  }
  wheelLock = true;
  // offsetLeft, not getBoundingClientRect. A rect on a scrolling container reports where the
  // element is *right now*, mid-animation and mid-snap, so a delta computed from it is a delta
  // from a moving target: the wheel settled a half step off and showed a neighbouring number
  // for the first instant of the step, which is the instant the customer looks at it.
  const want = b.offsetLeft + b.offsetWidth / 2 - wheel.clientWidth / 2;
  if (smooth) wheel.scrollTo({ left: want, behavior: "smooth" });
  else wheel.scrollLeft = want;
  clearTimeout(centerWheel.t);
  centerWheel.t = setTimeout(() => {
    wheelLock = false;
    // Close the loop: whatever ended up under the marker must be the selected size. Fonts
    // landing, a reflow, or an interrupted smooth scroll can all leave it a notch off, and a
    // wheel that disagrees with the number is worse than no wheel at all.
    if (wheel.clientWidth && wheelIndexAtCentre() !== i && tries < 3) {
      centerWheel(i, false, tries + 1);
    }
  }, smooth ? 420 : 80);
}

function wheelIndexAtCentre() {
  const wr = wheel.getBoundingClientRect(), mid = wr.left + wr.width / 2;
  let best = sizeIdx, bestD = Infinity;
  for (const b of wheel.querySelectorAll(".wsz")) {
    const r = b.getBoundingClientRect();
    const d = Math.abs(r.left + r.width / 2 - mid);
    if (d < bestD) { bestD = d; best = Number(b.dataset.idx); }
  }
  return best;
}

/**
 * Only a scroll the customer started may change the size.
 *
 * The selection used to be whatever sat under the marker, so ANY scroll spoke for her: a
 * reflow, a font landing, the browser restoring a position. On a real phone that desynced the
 * wheel from the reading badly enough to show "60" while EU 52 was selected, and it never
 * reproduced in emulation. Rather than keep guessing at the trigger, the rule is now explicit,
 * and a scroll nobody asked for is undone instead of obeyed.
 */
let userScrolling = false, userScrollTimer = 0;
wheel.addEventListener("pointerdown", () => {
  userScrolling = true;
  clearTimeout(userScrollTimer);
});
for (const ev of ["pointerup", "pointercancel"]) {
  wheel.addEventListener(ev, () => {
    clearTimeout(userScrollTimer);
    // Momentum keeps the wheel moving after the finger lifts, so stay in user mode briefly.
    userScrollTimer = setTimeout(() => { userScrolling = false; }, 1200);
  });
}

let wheelRaf = 0;
wheel.addEventListener("scroll", () => {
  if (wheelLock || wheelRaf || wheel.clientWidth === 0) return;
  wheelRaf = requestAnimationFrame(() => {
    wheelRaf = 0;
    const i = wheelIndexAtCentre();
    if (userScrolling) {
      // iOS momentum runs well past the finger lifting, so keep the window alive while the
      // wheel is still visibly moving rather than cutting the customer off mid-flick.
      clearTimeout(userScrollTimer);
      userScrollTimer = setTimeout(() => { userScrolling = false; }, 1200);
    }
    if (i === sizeIdx) return;
    if (userScrolling) { sizeIdx = i; guidedResult = null; drawMeasure(); }
    else centerWheel(sizeIdx);          // nobody asked for this: put it back
  });
});
wheel.addEventListener("click", (e) => {
  const b = e.target.closest(".wsz");
  if (!b) return;
  sizeIdx = Number(b.dataset.idx);
  guidedResult = null;
  centerWheel(sizeIdx, true);
  drawMeasure();
});

function rulerGeom() {
  // Tight padding on purpose: every pixel of inset costs range, and the scale has to reach
  // 61mm (the largest stocked size) even on a 320px screen.
  const pad = 6;
  const w = rulerEl.clientWidth - pad * 2, h = rulerEl.clientHeight - pad * 2;
  return { pad, w, h, L: Math.hypot(w, h), deg: (Math.atan2(h, w) * 180) / Math.PI };
}

function drawRuler() {
  const g = rulerGeom();
  rulerSpan = Math.min(RULER_MODE[mMethod].max, g.L / pxPerMm);
  let html = "";
  for (let mm = 0; mm <= Math.floor(rulerSpan); mm++) {
    const cls = mm % 10 === 0 ? "t10" : mm % 5 === 0 ? "t5" : "t1";
    // Counter-rotated so labels stay upright, and anchored so they run away from the axis.
    const label = mm % 10 === 0
      ? "<b style='transform:rotate(" + -g.deg + "deg)" +
        (mm === 0 ? "" : " translateX(-100%)") + "'>" + mm + "</b>" : "";
    html += "<i class='tick " + cls + "' style='left:" + mm * pxPerMm + "px'>" + label + "</i>";
  }
  rulerEl.innerHTML = "<div id='ruler-axis' style='left:" + g.pad + "px;top:" + g.pad +
    "px;width:" + g.L + "px;transform:rotate(" + g.deg + "deg)'>" + html +
    "<div id='ruler-marker' style='left:" + Math.min(rulerMm, rulerSpan) * pxPerMm + "px'></div></div>";
}

function drawCompare() {
  const idx = [sizeIdx - 1, sizeIdx, sizeIdx + 1].filter((i) => i >= 0 && i < CAT.sizes.length);
  $("compare").innerHTML = idx.map((i) => {
    const px = CAT.toId(CAT.sizes[i]) * pxPerMm;
    return "<div class='cmp" + (i === sizeIdx ? " mid" : "") + "'>" +
      "<i style='width:" + px + "px;height:" + px + "px'></i>" +
      "<span>" + CAT.scale + " " + CAT.sizes[i] + "</span></div>";
  }).join("");
}

function drawMeasure() {
  const isRuler = mMethod !== "circle";
  const showGuided = !isRuler && guided;
  disc.hidden = isRuler || compareOn;
  $("compare").hidden = isRuler || !compareOn;
  rulerEl.hidden = !isRuler;
  $("m-guided").hidden = !showGuided;
  $("m-normal").hidden = showGuided;
  $("m-wheelwrap").hidden = isRuler;
  $("m-hint").hidden = isRuler;
  $("m-minor").hidden = isRuler;
  $("m-guide-row").hidden = isRuler || !FEATURES.guided;

  // Settle the banner BEFORE anything measures the stage: it sits above the stage, so toggling
  // it changes the stage height, and the ruler was being laid out against the old one.
  innerMm = isRuler ? RULER_MODE[mMethod].toInner(rulerMm) : CAT.toId(sizeAt(showGuided ? Math.floor((lo + hi) / 2) : sizeIdx));
  const drawnPx = innerMm * pxPerMm;
  const clipped = !isRuler &&
    (mStage.clientHeight < drawnPx + 10 || mStage.clientWidth < drawnPx + 10);
  const sideways = innerWidth > innerHeight;
  $("m-next").disabled = clipped;
  $("m-next").style.opacity = clipped ? ".4" : "1";
  $("zoom-banner").hidden = (!isFramed() || EMBEDDED) && !clipped;
  $("zoom-banner").textContent = t(clipped ? (sideways ? "rotate" : "tooBigForScreen") : "framed");

  if (isRuler) {
    drawRuler();
  } else {
    if (showGuided) sizeIdx = Math.floor((lo + hi) / 2);
    applyRim();
    // The element's OUTER size, rim included, is the ring size. Setting width here and letting
    // border-box absorb the rim is what keeps that true.
    const px = innerMm * pxPerMm;
    disc.style.width = px + "px"; disc.style.height = px + "px";

    if (compareOn) drawCompare();
    wheel.querySelectorAll(".wsz").forEach((b) =>
      b.setAttribute("aria-current", String(Number(b.dataset.idx) === sizeIdx)));
    const total = Math.ceil(Math.log2(CAT.sizes.length));
    $("m-prog").innerHTML = Array.from({ length: total },
      (_, i) => "<i class='" + (i < asked ? "on" : "") + "'></i>").join("");
    $("m-undo").disabled = guidedHistory.length === 0;
    $("m-undo").style.opacity = guidedHistory.length ? "1" : ".4";
  }

  const snap = snapToStocked(innerMm, CAT);
  const both = bothScales(snap.mm);
  const loMm = CAT.toId(CAT.sizes[0]) - 0.4;
  const hiMm = CAT.toId(CAT.sizes[CAT.sizes.length - 1]) + 0.4;
  const inRange = innerMm >= loMm && innerMm <= hiMm;
  $("m-size").textContent = innerMm <= 0 ? t("setMarker")
    : inRange ? (CAT.scale === "UK" ? "UK " + snap.size + "  ·  US " + both.us
                                    : "US " + both.us + "  ·  EU " + both.eu) : t("outOfRange");
  $("m-mm").textContent = isRuler && rulerMm > 0
    ? rulerMm.toFixed(1) + t(RULER_MODE[mMethod].unit) + " · " + innerMm.toFixed(1) + t("mmAcross")
    : innerMm.toFixed(1) + t("mmInside");
  $("m-sub").textContent = t(isRuler ? (mMethod === "strip" ? "subStrip" : "subRuler")
    : showGuided ? "subGuided" : "subCircle");
  $("m-hint").textContent = guidedResult === null ? t("wheelHint")
    : t("guidedFound") + CAT.scale + " " + guidedResult + t("guidedCheck");
  $("m-hint").style.color = guidedResult === null ? "" : "var(--accent)";
  $("m-eye").hidden = isRuler;
  $("m-note").textContent = t(isRuler ? (mMethod === "strip" ? "noteStrip" : "noteRuler") : "noteCircle");
  document.documentElement.dataset.innerMm = innerMm.toFixed(3);

  // Running off the end of the scale is only knowable after the ruler is drawn.
  const off = isRuler && rulerSpan > 0 && rulerMm >= rulerSpan - 0.05;
  if (off) { $("zoom-banner").hidden = false; $("zoom-banner").textContent = t("offScale"); }
}

function setMeasureMethod(next) {
  mMethod = next;
  compareOn = false;
  // The label has to follow the state it describes, or the button reads "show one" while one
  // is already showing.
  $("m-compare").textContent = t("compareThree");
  document.querySelectorAll("[data-mmethod]").forEach((b) =>
    b.setAttribute("aria-pressed", String(b.dataset.mmethod === next)));
  if (next !== "circle" && innerMm > 0) rulerMm = next === "strip" ? innerMm * Math.PI : innerMm;
  drawMeasure();
}
document.querySelectorAll("[data-mmethod]").forEach((b) =>
  b.addEventListener("click", () => setMeasureMethod(b.dataset.mmethod)));

/* The guided search. "White shows" means the circle is smaller than the hole, so the answer
   lies above it; "no white" means this size already covers the hole, so it is the answer or
   below. The target is the smallest size that shows no white. */
document.querySelectorAll("[data-ans]").forEach((b) => b.addEventListener("click", () => {
  guidedHistory.push([lo, hi]);
  const mid = Math.floor((lo + hi) / 2);
  if (b.dataset.ans === "small") lo = mid + 1; else hi = mid;
  asked++;
  if (lo >= hi) {
    // Do not jump to a result. Hand the answer back to the wheel with the circle drawn at that
    // size so it can be looked at and overruled: being told a size with no chance to check it
    // is exactly what made the guided path feel untrustworthy.
    sizeIdx = lo; guided = false; guidedResult = CAT.sizes[lo];
    drawMeasure(); centerWheel(sizeIdx, true);
    return;
  }
  drawMeasure();
}));
$("m-undo").addEventListener("click", () => {
  if (!guidedHistory.length) return;
  [lo, hi] = guidedHistory.pop();
  asked = Math.max(0, asked - 1);
  drawMeasure();
});
function startGuided() {
  lo = 0; hi = CAT.sizes.length - 1; asked = 0; guidedHistory = []; guided = true;
  guidedResult = null;
  setMeasureMethod("circle");
}
$("m-guide").addEventListener("click", startGuided);
$("m-manual").addEventListener("click", () => {
  guided = false; setMeasureMethod("circle"); centerWheel(sizeIdx);
});

function rulerFromEvent(e) {
  const rect = rulerEl.getBoundingClientRect(), g = rulerGeom();
  const dx = e.clientX - rect.left - g.pad, dy = e.clientY - rect.top - g.pad;
  // Project the touch onto the tilted axis rather than reading a single coordinate.
  rulerMm = Math.max(0, Math.min(RULER_MODE[mMethod].max, ((dx * g.w + dy * g.h) / g.L) / pxPerMm));
  drawMeasure();
}
let dragging = false;
rulerEl.addEventListener("pointerdown", (e) => {
  dragging = true; rulerEl.setPointerCapture(e.pointerId); rulerFromEvent(e);
});
rulerEl.addEventListener("pointermove", (e) => { if (dragging) rulerFromEvent(e); });
// pointercancel as well: a drag interrupted by the system (a call, a gesture taken over by the
// browser) never fires pointerup, and the marker then followed every later touch.
for (const ev of ["pointerup", "pointercancel"]) {
  rulerEl.addEventListener(ev, () => { dragging = false; });
}

$("m-compare").addEventListener("click", () => {
  compareOn = !compareOn;
  $("m-compare").textContent = t(compareOn ? "showOne" : "compareThree");
  drawMeasure();
});
$("m-invert").addEventListener("click", () => {
  const on = mStage.classList.toggle("inverted");
  $("m-invert").textContent = t(on ? "lightBg" : "darkBg");
});
$("m-back").addEventListener("click", () => go("s-cal"));
$("m-nav").addEventListener("click", () => go("s-cal"));
$("m-next").addEventListener("click", () => { if (innerMm > 0) showResult(); });

if (window.visualViewport) {
  // Follow the pinch instead of complaining about it.
  window.visualViewport.addEventListener("resize", () => {
    syncScale(); drawMeasure();
    if ($("s-cal").classList.contains("on")) initCal();
    dumpDebug();
  });
}

/* ---------- step 3: result -------------------------------------------- */
function showResult() {
  const snap = snapToStocked(innerMm, CAT);
  const both = bothScales(snap.mm);
  if (CAT.scale === "UK") {
    $("r-us").textContent = snap.size;
    $("r-eu").textContent = both.us;
    $("r-card-us").classList.remove("secondary");
    $("r-card-eu").classList.add("secondary");
  } else {
  $("r-us").textContent = both.us;
  $("r-eu").textContent = both.eu;
  // Only one scale names an actual variant on this store; the other is a conversion.
  $("r-card-us").classList.toggle("secondary", CAT.scale !== "US");
  $("r-card-eu").classList.toggle("secondary", CAT.scale !== "EU");
  }
  $("r-equiv").innerHTML = "<b>" + snap.mm.toFixed(2) + "</b>" + t("mmInside");

  const wa = $("r-wa"), waNum = String(window.RING_SIZER_WHATSAPP || "").replace(/[^0-9]/g, "");
  wa.hidden = !waNum;
  wa.textContent = t("waResult");
  if (waNum) {
    wa.href = "https://api.whatsapp.com/send?phone=" + waNum + "&text=" +
      encodeURIComponent(t("waResultMsg") + CAT.scale + " " + snap.size +
        " (" + snap.mm.toFixed(2) + t("mmUnit") + ")");
  }

  const banner = $("r-banner");
  banner.hidden = snap.delta <= 0.3;
  if (!banner.hidden) {
    banner.textContent = t("straddle") + CAT.scale + " " + snap.size + t("straddle2");
  }
  go("s-result");
}
function backToMeasure() { guided = false; go("s-measure"); }
$("r-back").addEventListener("click", backToMeasure);
$("r-nav").addEventListener("click", backToMeasure);
$("r-cta").addEventListener("click", () => {
  const snap = snapToStocked(innerMm, CAT), both = bothScales(snap.mm);
  // The product page listens for this and selects the matching variant. Emitting an event
  // rather than reaching into the theme keeps the sizer identical on the page and in a modal.
  // A host that acts on it calls preventDefault. On the standalone page nothing does, and the
  // button was then inert: the last screen of the flow ended in a button that did nothing.
  const ev = new CustomEvent("ringsizer:selected", { cancelable: true,
    detail: { scale: CAT.scale, size: snap.size, innerMm: snap.mm, us: both.us, eu: both.eu } });
  const handled = !window.dispatchEvent(ev);
  if (EMBEDDED) {
    // Same origin, but postMessage anyway: the product page owns its own variant picker and
    // reaching across into it from here would couple this tool to one theme's markup.
    // Pinned to our own origin in production. A file:// copy has no real origin to pin to,
    // and a ring size is not a secret, so the receiver is the side that has to check: the
    // theme block only accepts a message whose source is the frame it created itself.
    const target = /^https?:/.test(location.origin || "") ? location.origin : "*";
    parent.postMessage({ source: "ringsizer", type: "selected", ...ev.detail }, target);
    return;
  }
  const shop = samePath(window.RING_SIZER_SHOP_URL);
  if (!handled && shop) location.href = shop;
});

/* ---------- language --------------------------------------------------- */
function applyLang() {
  document.documentElement.lang = LANG;
  document.documentElement.dir = LANG === "he" ? "rtl" : "ltr";
  document.querySelectorAll("[data-t]").forEach((el) => { el.textContent = t(el.dataset.t); });
  const lt = $("lang-toggle"); if (lt) lt.textContent = t("lang");
  // note5 used to link to printable.html, which exists in this folder and nowhere on the
  // storefront, so on the live page it was a 404 sitting under the customer's size.
  $("r-notes").innerHTML = ["note1", CAT.scale === "EU" ? "note2eu" : "note2", "note3", "note4"]
    .map((k) => "<li>" + t(k) + "</li>").join("");
  if (!$("r-wa").hidden) $("r-wa").textContent = t("waResult");
  const policy = samePath(window.RING_SIZER_POLICY_URL) || "/policies/refund-policy";
  $("r-legal").innerHTML = t("legal") +
    "<a href='" + policy + "' target='_blank' rel='noopener'>" + t("legalLink") + "</a>" +
    t("legalEnd");
  $("m-hint").textContent = guidedResult === null ? t("wheelHint")
    : t("guidedFound") + CAT.scale + " " + guidedResult + t("guidedCheck");
  $("m-compare").textContent = t(compareOn ? "showOne" : "compareThree");
  $("m-invert").textContent = t(mStage.classList.contains("inverted") ? "lightBg" : "darkBg");
  fillPickers();
  setMethod(method);
  setMeasureMethod(mMethod);
}
$("lang-toggle")?.addEventListener("click", () => {
  LANG = LANG === "en" ? "he" : "en";
  applyLang();
});

/* ---------- shell ------------------------------------------------------ */
function go(id) {
  if (typeof HANDHELD !== "undefined" && !HANDHELD && id !== "s-desktop") return;
  document.querySelectorAll(".step").forEach((s) => s.classList.toggle("on", s.id === id));
  if (id === "s-cal") initCal();
  if (id === "s-measure") {
    drawMeasure();
    requestAnimationFrame(() => requestAnimationFrame(() => centerWheel(sizeIdx)));
  }
  window.scrollTo(0, 0);
  dumpDebug();
}

$("dbg-toggle")?.addEventListener("click", () => { $("dbg").hidden = !$("dbg").hidden; dumpDebug(); });
$("dbg")?.addEventListener("click", (e) => {
  if (e.target.id !== "swap-store") return;
  CAT = CAT === CATALOGUE.us ? CATALOGUE.il : CATALOGUE.us;
  // guided is opt-in, so switching stores must not silently force the quiz back on.
  lo = 0; hi = CAT.sizes.length - 1; asked = 0; guided = false; guidedHistory = [];
  sizeIdx = Math.floor(CAT.sizes.length / 2);
  LANG = CAT.region === "IL" ? "he" : "en";
  buildWheel(); applyLang(); drawMeasure(); centerWheel(sizeIdx); dumpDebug();
});
const NL = String.fromCharCode(10);
function dumpDebug() {
  const el = $("dbg");
  if (!el || el.hidden) return;
  el.innerHTML =
    "build         <b>2fd1b85</b>\n" +
    "SIZE SHOWN    <b>" + CAT.scale + " " + snapToStocked(innerMm, CAT).size +
      "</b>   inner <b>" + innerMm.toFixed(2) + " mm</b>" + NL +
    "CALIBRATED BY <b>" + source + (devLabel ? ": " + devLabel : "") + "</b>" + NL +
    "CIRCLE DRAWN  <b>" + (innerMm * pxPerMm).toFixed(1) + " css px</b>  at " +
      pxPerMm.toFixed(4) + " px/mm" + NL +
    "screen        <b>" + detected.key + "</b>  short edge " + detected.shortCss + " css px" +
      (detected.basis === "layout" ? "   (reported " + detected.screenKey + ", not trusted)" : "") + "\n" +
    "identified by <b>" + detected.basis + "</b>\n" +
    "layout        innerWidth " + innerWidth + (EMBEDDED ? "  (inside the frame)" : "") + NL +
    // The zoom ratio, from whichever pair was actually measured together. Inside the product
    // modal the frame's innerWidth and the parent's screen width are different spaces, and
    // dividing them warned an unzoomed iPhone 16 that it was zoomed by 5%.
    "zoom test     " + (layoutMismatch() === null ? "not available (framed, untrusted)"
      : layoutMismatch().toFixed(4) + (Math.abs(layoutMismatch() - 1) <= 0.02 ? "  ok"
        : detected.basis === "layout" ? "  (the device's own gap, not zoom)" : "  <-- ZOOMED")) + NL +
    (EMBEDDED ? "handover      parent screen " + detected.shortCss + "  parent layout " +
      (new URLSearchParams(location.search).get("lw") || "?") + "  frame " + innerWidth + NL : "") +
    "matched       <b>" + detected.matched + "</b>  " + detected.label + (detected.ambiguous ? "  [AMBIGUOUS]" : "") + "\n" +
    "detected      <b>" + detected.pxPerMm.toFixed(3) + "</b> css px/mm  (screen " + detected.widthMm + " mm wide)\n" +
    "in use        <b>" + pxPerMm.toFixed(3) + "</b> css px/mm  (" + source + (devLabel ? ": " + devLabel : "") + ")\n" +
    "width in use  <b>" + devWidthMm.toFixed(1) + " mm</b> of glass across the screen\n" +
    "method        <b>" + method + "</b> / <b>" + mMethod + (guided ? " guided" : " manual") + "</b>\n" +
    "search        lo " + lo + " hi " + hi + " asked " + asked + " undo " + guidedHistory.length + "\n" +
    "zoom          pinch " + vvScale().toFixed(3) + "  base " + basePxPerMm.toFixed(3) + "  framed " + isFramed() + "\n" +
    "inner dia     <b>" + innerMm.toFixed(2) + " mm</b>  -> " + CAT.scale + " " + snapToStocked(innerMm, CAT).size + "\n" +
    "catalogue     <b>" + CAT.store + "</b>  lang " + LANG +
      "  <u id='swap-store' style='cursor:pointer'>switch store</u>\n" +
    "ua            " + navigator.userAgent;
}

/**
 * Which optional paths the customer is offered. Hidden, not deleted: every one of these is
 * still exercised by the test suites, which turn them all back on with ?features=all, so
 * bringing one back is a one-word change rather than a rewrite.
 */
const FEATURES = Object.assign(
  { card: false, coin: false, inch: false, guided: false, strip: false },
  /[?&]features=all/.test(location.search)
    ? { card: true, coin: true, inch: true, guided: true, strip: true } : null,
  window.RING_SIZER_FEATURES || null
);

function applyFeatures() {
  for (const m of ["card", "coin"]) {
    const b = document.querySelector('[data-method="' + m + '"]');
    if (b) b.hidden = !FEATURES[m];
  }
  // A lone "my phone" tab is a tab bar with nothing to switch to.
  document.querySelector("#s-cal .methods").hidden = !FEATURES.card && !FEATURES.coin;
  if (!FEATURES[method]) setMethod("device");
  // Same on the measuring screen: with the paper strip and the ruler gone, the circle is not
  // one option among three, it is the tool.
  $("m-methods").hidden = !FEATURES.strip;
  if (!FEATURES.strip && mMethod !== "circle") setMeasureMethod("circle");
}

/**
 * Which store this copy belongs to. The host page sets it; standalone defaults to the US
 * catalogue. Without this the Israeli store would have shown US 3 to 9.5 instead of EU 43 to
 * 60, in English, which is the wrong tool wearing the right clothes.
 */
{
  const region = String(window.RING_SIZER_STORE || "us").toLowerCase();
  const country = String(window.RING_SIZER_COUNTRY || "").toUpperCase();
  if (region === "us" && (country === "GB" || country === "AU")) {
    CAT = { ...CATALOGUE.uk, region: country };
    lo = 0; hi = CAT.sizes.length - 1;
    sizeIdx = Math.max(0, CAT.sizes.indexOf("N"));
    coin = COINS[CAT.region][0];
    // the result screen leads with the letter and shows the US size beside it
    document.querySelector("#r-card-us .size-scale").dataset.t = "ukSize";
    document.querySelector("#r-card-eu .size-scale").dataset.t = "usSize";
  } else if (region === "us" && country === "CA") {
    CAT = { ...CATALOGUE.us, region: "CA" };
    coin = COINS[CAT.region][0];
  }
  if (window.RING_SIZER_NOLANG === "1") { const lt = document.getElementById("lang-toggle"); if (lt) lt.hidden = true; }
  if (region === "il") {
    CAT = CATALOGUE.il;
    LANG = "he";
    lo = 0; hi = CAT.sizes.length - 1;
    sizeIdx = Math.max(0, CAT.sizes.indexOf(52));
    coin = COINS[CAT.region][0];
  }
}

/**
 * Phones only, and not as a matter of taste.
 *
 * Every millimetre this tool draws comes from knowing the physical width of the screen, and
 * the only two ways it has to know are a phone model it recognises and a phone model the
 * customer names. Neither exists for a laptop: monitors are not identifiable from a browser,
 * and the same 1920 px sits on a 13 inch panel and a 27 inch one. The circle would still be
 * drawn, confidently, at any size at all, and a wrong ring size is a return and a remake.
 *
 * Coarse pointer AND a touch digitiser AND a short edge of phone proportions: a touchscreen
 * laptop clears the first two and fails the third, and a desktop browser narrowed to a phone
 * width still reports the real screen, so resizing a window is not a way in.
 */
function isHandheld(win) {
  win = win || window;
  if (/[?&]desktop=1/.test(location.search)) return true;   // for testing on a real desktop
  const coarse = win.matchMedia && win.matchMedia("(any-pointer: coarse)").matches;
  const touch = (win.navigator.maxTouchPoints || 0) > 0;
  // screenGeometry, not win.screen: inside the product modal the honest answer comes from the
  // page that framed us, and it is the same answer every other measurement here is based on.
  const shortEdge = screenGeometry(win).shortCss;
  return Boolean(coarse && touch && shortEdge > 0 && shortEdge <= 520);
}

const HANDHELD = isHandheld();
if (!HANDHELD) {
  // location.href, not a hardcoded address: this same file runs on the dedicated page, inside
  // a product modal and from the file system, and each of those is a different thing to type.
  $("dt-url").textContent = location.href.split("?")[0].replace(/^https?:\/\//, "");
  go("s-desktop");
}

/**
 * Hold the page still. Every pixel of zoom is a millimetre of error, and Safari has ignored
 * `user-scalable=no` since iOS 10, so the meta tag alone does nothing. Blocking the gestures
 * does. `visualViewport` still corrects the scale underneath as a backstop, for any zoom that
 * gets through or is applied from outside the page.
 */
(function lockZoom() {
  const stop = (e) => e.preventDefault();
  for (const ev of ["gesturestart", "gesturechange", "gestureend"]) {
    document.addEventListener(ev, stop, { passive: false });
  }
  document.addEventListener("touchmove", (e) => {
    if (e.touches.length > 1) e.preventDefault();
  }, { passive: false });
  // Double-tap to zoom arrives as a dblclick on iOS.
  document.addEventListener("dblclick", stop, { passive: false });
})();

const saved = loadSaved();
if (saved) {
  basePxPerMm = saved.pxPerMm;
  source = "saved";
  // The width in use has to match the scale in use. Restoring one without the other made the
  // stage report a screen width the circle was not drawn from, which is the exact confusion
  // that took three rounds to untangle in the field.
  devWidthMm = cssAcrossScreen() / basePxPerMm;
}
syncScale();
addEventListener("resize", () => {
  if ($("s-cal").classList.contains("on")) initCal();
  if ($("s-measure").classList.contains("on")) drawMeasure();
});
applyFeatures();
buildWheel();
applyLang();
// Web fonts change the wheel's metrics when they land, so re-assert the selection afterwards
// rather than trusting a centring done against fallback text.
if (document.fonts && document.fonts.ready) {
  document.fonts.ready.then(() => centerWheel(sizeIdx));
}
</script>
{% endraw %}
</div>
<style>
  /* The tool sizes itself against the viewport, so give it the viewport and nothing else. */
  .ring-sizer-host { position: fixed; inset: 0; z-index: 2147483000; background: #fff;
                     padding-bottom: var(--rs-bottom, 0px); }
  .ring-sizer-host #app { height: 100%; }
</style>
<script>
  // Shopify's own preview bar is a fixed overlay that sits on top of everything, including a
  // full-screen section, and it covers the primary button. It exists only while previewing an
  // unpublished theme, so make room for it only when it is actually there.
  (function () {
    var check = function () {
      var bar = document.getElementById("PBarNextFrameWrapper") || document.getElementById("preview-bar-iframe");
      document.querySelector(".ring-sizer-host").style.setProperty("--rs-bottom", bar ? "60px" : "0px");
    };
    check();
    setTimeout(check, 1500);
    setTimeout(check, 4000);
  })();
</script>
