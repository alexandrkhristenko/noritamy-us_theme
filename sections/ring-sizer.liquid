{% comment %}
  Ring size finder (noritamy.com copy, generated from assets/ring-sizer-app.html). Self-contained: it reads no theme styles and emits none outside its own
  selectors. The body below is escaped so Liquid leaves the script untouched.
{% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500&family=Oswald:wght@200;300;400&family=Rubik:wght@300;400;500&display=swap" rel="stylesheet">
<div class="ring-sizer-host">
<script>window.RING_SIZER_STORE = "us";
window.RING_SIZER_COUNTRY = {{ localization.country.iso_code | json }};
window.RING_SIZER_NOLANG = "1";
window.RING_SIZER_SHOP_URL = {{ collections.rings.url | default: "/collections/rings" | json }};
window.RING_SIZER_WHATSAPP = "972544559091";
window.RING_SIZER_POLICY_URL = {{ shop.refund_policy.url | default: "/policies/refund-policy" | json }};</script>
{% raw %}
<style>
  /* Palette and type lifted from the live Noritamy storefront: Oswald headings, Montserrat
     body, #1e1f21 ink on white, #eae8e6 rules, and the terracotta from the brand's own colour
     schemes. Hebrew switches to Rubik, which is what the storefront itself uses, because
     neither Oswald nor Montserrat carries Hebrew glyphs. */
  :root {
    --bg: #ffffff; --surface: #f8f8f8; --ink: #1e1f21; --line: #eae8e6;
    --muted: rgba(30,31,33,.55); --accent: #7d5449; --disc-fill: #4cc9e8; --rim-color: #101010; --rim-dark: #ffffff;
    --head: "Oswald", "Helvetica Neue", Arial, sans-serif;
    --body: "Montserrat", -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
  }
  html[lang="he"] {
    --head: "Rubik", "Helvetica Neue", Arial, sans-serif;
    --body: "Rubik", -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
  }
  html[lang="he"] h1 { letter-spacing: .02em; }
  html[lang="he"] button.primary, html[lang="he"] button.ghost,
  html[lang="he"] .methods button, html[lang="he"] .answers button { letter-spacing: .04em; }

  /* pan-y, not none: vertical scrolling still works on the result screen, but the browser
     stops handling pinch and double-tap, which are what move the drawing off true scale. */
  html, body { touch-action: pan-y; }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  /* Any explicit display beats the hidden attribute's UA display:none, so a .btns row marked
     hidden still occupied its 54px and quietly ate the ruler's range. Settle it once here
     rather than remembering to add a [hidden] rule beside every new display value. */
  [hidden] { display: none !important; }
  html, body { margin: 0; height: 100%; overscroll-behavior: none; }
  body {
    background: var(--bg); color: var(--ink); font: 300 15px/1.5 var(--body);
    -webkit-font-smoothing: antialiased; user-select: none; -webkit-user-select: none;
  }
  /* Bounded height, not min-height: the calibration graphic is sized in physical millimetres
     and would otherwise push the controls off screen instead of being fitted against them. */
  #app { height: 100vh; height: 100dvh; display: flex; flex-direction: column; }
  .step { display: none; flex: 1; flex-direction: column; min-height: 0; }
  .step.on { display: flex; }

  header { padding: 12px 22px 0; text-align: center; position: relative; }
  h1 { font: 300 19px/1.2 var(--head); letter-spacing: .09em; text-transform: uppercase;
       margin: 0 0 6px; }
  p.sub { margin: 0 auto; color: var(--muted); font-size: 12.5px; line-height: 1.5;
          max-width: 40ch; min-height: 2.6em; }
  .pips { display: flex; gap: 5px; justify-content: center; margin: 0 0 10px; }
  .pip { width: 20px; height: 1px; background: var(--line); }
  .pip.on { background: var(--ink); }

  /* One back control per step, always in the same place, so there is a way out of every
     screen including part-way through the guided questions. */
  .nav { position: absolute; top: 6px; inset-inline-start: 12px; background: none; border: 0;
         padding: 8px 10px; color: var(--muted); font: 300 12px var(--body); }
  .nav::before { content: "‹"; font-size: 17px; margin-inline-end: 5px; vertical-align: -1px; }
  html[dir="rtl"] .nav::before { content: "›"; }
  .nav[hidden] { display: none; }
  /* Fixed, not inside a step's header: a Hebrew speaker who lands on the measuring screen
     still has to be able to switch. */
  .lang { position: fixed; top: 2px; inset-inline-end: 58px; z-index: 5; background: none;
          border: 0; padding: 7px 6px; color: var(--muted); font: 400 11px var(--body);
          letter-spacing: .08em; text-decoration: underline; text-underline-offset: 3px; }

  .stage { flex: 1; min-height: 110px; position: relative; display: grid; place-items: center;
           overflow: hidden; touch-action: none; background: var(--bg); }

  /* Bank card. Only its 53.98mm height is the reference, so the 85.6mm width is free to run
     off both sides. Top edge anchored: a card is wider than a phone and hides what is under
     it, so a strip that is too SHORT would otherwise look exactly like a perfect match. */
  #card { position: relative; border-radius: 8px;
    background: linear-gradient(180deg, #efeae4 0%, #ded6ca 100%);
    border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); }
  #card.clipped { border-radius: 0;
    --fade: linear-gradient(to right, transparent 0, #000 30px, #000 calc(100% - 30px), transparent 100%);
    -webkit-mask-image: var(--fade); mask-image: var(--fade); }
  .chip { position: absolute; inset-inline-start: 8%; top: 50%; transform: translateY(-50%);
    width: 11%; max-width: 44px; aspect-ratio: 4/3; border-radius: 14%;
    background: linear-gradient(145deg,#d9c298,#a98c5e); }
  #card.clipped .chip { inset-inline-start: 22%; }
  #coin { border-radius: 50%; background: linear-gradient(150deg,#ddd6c9,#a9a191 60%,#c4bcab);
          box-shadow: inset 0 0 0 1px rgba(0,0,0,.12); }
  .guide { position: absolute; left: 0; right: 0; height: 0;
           border-top: 1px dashed rgba(30,31,33,.4); }

  /* Picking a phone needs no picture of a card, so the stage carries the result instead: the
     phone we believe is in the customer's hand, and the circle it is about to draw. An empty
     stage with one line of grey text floating in the middle of it read as a broken page. */
  #devnote { text-align: center; padding: 0 26px; }
  #devnote .lead { display: block; color: var(--muted); font-size: 11px; letter-spacing: .12em;
                   text-transform: uppercase; margin-bottom: 7px; }
  #devnote b { display: block; font: 300 20px/1.35 var(--head); letter-spacing: .04em;
               margin-bottom: 8px; }
  #devnote span { display: block; color: var(--muted); font-size: 12.5px; line-height: 1.5; }
  #devnote em { display: block; margin-top: 18px; font-style: normal; font-size: 12px;
                line-height: 1.6; color: var(--muted); }
  #devnote u { display: inline-block; margin-top: 14px; color: var(--accent); font-size: 12px;
               text-underline-offset: 3px; cursor: pointer; }

  /* The measuring circle, with a hairline red rim.
     Without the rim the test is one-sided: a circle larger than the hole hides under the band
     and looks exactly like a perfect fit. The rim makes it three-state. White outside the red
     means too small, red hidden means too big, and a thin red line touching the metal with no
     white is the size.
     A zero-blur INSET shadow, not a border: Chromium floors border-width to whole pixels, so
     a 1.81px rim rendered at 1px. An inset shadow keeps the fractional thickness and, being a
     paint effect, cannot touch layout, so the outer diameter stays exactly the ring size. */
  /* Inverted on purpose: a pale blue centre inside a black ring.
     The three states are now three different colours rather than three amounts of one colour,
     and the two that matter are colour FLIPS at the metal: white outside the black means too
     small, black touching means right, and pale blue touching means the ring has covered the
     black entirely, so too big. A shade of red going slightly darker was a judgement nobody
     could make on gold; this one needs no judgement at all. */
  #disc, .cmp i { border-radius: 50%; background: var(--disc-fill);
    box-shadow: inset 0 0 0 var(--rim, 2px) var(--rim-color); }
  .stage.inverted { background: #14120f; }
  .stage.inverted #disc, .stage.inverted .cmp i { box-shadow: inset 0 0 0 var(--rim, 2px) var(--rim-dark); }
  .stage.inverted .stage-note, .stage.inverted .cmp span { color: rgba(255,255,255,.5); }
  .stage-note { position: absolute; bottom: 8px; left: 0; right: 0; text-align: center;
    font-size: 11px; letter-spacing: .04em; color: var(--muted); pointer-events: none;
    padding: 0 16px; }
  /* Viewing at an angle reads small, and it is the one error the customer alone can prevent. */
  .eye { position: absolute; top: 8px; left: 0; right: 0; text-align: center; pointer-events: none;
    font: 400 11px/1.3 var(--body); letter-spacing: .05em; color: var(--accent); }
  .eye i { display: inline-block; width: 15px; height: 15px; margin-inline-end: 6px;
    vertical-align: -3px; border: 1.5px solid var(--accent); border-radius: 50%;
    position: relative; }
  .eye i::after { content: ""; position: absolute; inset: 4px; border-radius: 50%;
    background: var(--accent); }
  .stage.inverted .eye { color: #e0a99b; }
  .stage.inverted .eye i { border-color: #e0a99b; }
  .stage.inverted .eye i::after { background: #e0a99b; }

  #compare { display: flex; align-items: center; justify-content: center; gap: 4px; }
  .cmp { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .cmp i { display: block; }
  .cmp span { font: 300 11px/1 var(--head); letter-spacing: .1em; color: var(--muted); }
  .cmp.mid span { color: var(--ink); }

  /* Scale runs corner to corner: circumference reaches 61mm and an upright phone leaves only
     about 60mm of height once controls are placed, but the diagonal gives 85mm. */
  #ruler { position: absolute; inset: 0; }
  #ruler-axis { position: absolute; height: 0; transform-origin: 0 0;
                border-top: 1px solid var(--line); }
  .tick { position: absolute; top: 0; width: 0; border-left: 1px solid var(--ink); opacity: .45; }
  .tick.t1 { height: 8px; opacity: .25; }
  .tick.t5 { height: 15px; }
  .tick.t10 { height: 24px; opacity: .8; }
  .tick b { position: absolute; left: 3px; top: 26px; transform-origin: 0 0; white-space: nowrap;
            font: 300 11px/1 var(--head); letter-spacing: .06em; color: var(--ink); }
  #ruler-marker { position: absolute; top: -13px; width: 0; height: 33px;
                  border-left: 2px solid var(--accent); }

  .methods { display: flex; margin: 10px 22px 0; border: 1px solid var(--line); }
  .methods button { flex: 1; height: 33px; border: 0; background: transparent; color: var(--muted);
    font: 400 10.5px/1.2 var(--body); letter-spacing: .09em; text-transform: uppercase;
    padding: 0 2px; }
  .methods button + button { border-inline-start: 1px solid var(--line); }
  .methods button[aria-pressed="true"] { background: var(--ink); color: #fff; }

  .controls { padding: 12px 22px calc(16px + env(safe-area-inset-bottom)); background: var(--surface);
              border-top: 1px solid var(--line); }
  .readout { text-align: center; margin-bottom: 8px; }
  .readout b { display: block; font: 300 26px/1.1 var(--head); letter-spacing: .06em; }
  .readout small { display: block; color: var(--muted); font-size: 11px; margin-top: 5px;
                   letter-spacing: .06em; }
  .row { display: flex; align-items: center; gap: 10px; }
  .nudge { flex: 0 0 44px; height: 44px; border: 1px solid var(--line); background: #fff;
    border-radius: 50%; font-size: 20px; line-height: 1; color: var(--ink); }
  .nudge:active { background: #efece7; }
  input[type=range] { flex: 1; -webkit-appearance: none; appearance: none; height: 44px;
    background: transparent; }
  input[type=range]::-webkit-slider-runnable-track { height: 1px; background: var(--line); }
  input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 26px; height: 26px;
    border-radius: 50%; background: var(--ink); margin-top: -13px; }
  input[type=range]::-moz-range-track { height: 1px; background: var(--line); }
  input[type=range]::-moz-range-thumb { width: 26px; height: 26px; border: 0; border-radius: 50%;
    background: var(--ink); }
  select { width: 100%; height: 46px; padding: 0 12px; margin-bottom: 8px; border: 1px solid var(--line);
    background: #fff; color: var(--ink); font: 300 14px var(--body); border-radius: 0; appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%),
      linear-gradient(135deg, var(--muted) 50%, transparent 50%);
    background-position: calc(100% - 17px) 21px, calc(100% - 12px) 21px;
    background-size: 5px 5px, 5px 5px; background-repeat: no-repeat; }
  html[dir="rtl"] select { background-position: 12px 21px, 17px 21px; }
  /* Model names are Latin. In an RTL select each line was pushed to the right edge and the
     mixed runs ("iPhone 16 Plus", "Galaxy S24 Ultra / S23 Ultra") broke into a ragged column
     that was hard to scan. Forced LTR, the names line up under each other as one column, and
     the arrow moves back to the right where the box now starts. */
  html[dir="rtl"] #device-pick,
  html[dir="rtl"] #device-pick option,
  html[dir="rtl"] #device-pick optgroup { direction: ltr; text-align: left; }
  html[dir="rtl"] #device-pick { background-position: calc(100% - 17px) 21px,
                                 calc(100% - 12px) 21px; }
  .btns { display: flex; gap: 8px; margin-top: 10px; }
  button.primary { flex: 1; height: 48px; border: 0; background: var(--ink); color: #fff;
    font: 400 11px/1 var(--body); letter-spacing: .13em; text-transform: uppercase; }
  button.ghost { flex: 1; height: 44px; border: 1px solid var(--line); background: transparent;
    color: var(--muted); font: 400 10.5px/1 var(--body); letter-spacing: .1em;
    text-transform: uppercase; }
  /* Guided is the accurate path for anyone unsure, so it reads as an offer, not a footnote. */
  button.ghost.accent { border-color: var(--accent); color: var(--accent); }
  button:active { opacity: .82; }
  .minor { display: flex; gap: 16px; justify-content: center; margin-top: 10px; }
  .minor button, .linkish { background: none; border: 0; color: var(--muted); font: 300 11.5px var(--body);
    letter-spacing: .04em; text-decoration: underline; text-underline-offset: 3px; padding: 4px 0; }
  .linkish { display: block; width: 100%; margin-top: 10px; }
  /* The store's own WhatsApp bubble is a theme element, and this tool covers the viewport, so
     the bubble is underneath it and unreachable. Same number, our own doorway. */
  .wa.cta { border: 1px solid #25d366; text-decoration: none; margin-top: 12px;
            font-size: 12.5px; letter-spacing: .08em; text-transform: uppercase;
            padding: 15px 8px; }
  .wa { display: block; text-align: center; margin-top: 12px; padding: 10px 8px;
        color: var(--ink); font: 400 12px/1.4 var(--body); letter-spacing: .03em;
        text-decoration: underline; text-underline-offset: 3px; }
  .wa::before { content: ""; display: inline-block; width: 9px; height: 9px; border-radius: 50%;
                background: #25d366; margin-inline-end: 7px; vertical-align: 0; }

  /* Size wheel. Scroll-snap does the momentum and the detents natively, so the customer
     flicks rather than aims: every stop is a size the store actually stocks, and flicking
     between two neighbours turns a 4.9px difference into motion, which the eye reads far
     better than a still gap. */
  .wheel-wrap { position: relative; margin: 2px 0; }
  .wheel { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; padding: 8px 0 12px;
           scrollbar-width: none; -webkit-overflow-scrolling: touch; touch-action: pan-x; }
  .wheel::-webkit-scrollbar { display: none; }
  .wsz { flex: 0 0 64px; scroll-snap-align: center; background: none; border: 0; padding: 0;
         font: 300 19px/1.6 var(--head); letter-spacing: .06em; color: var(--ink); opacity: .3;
         transition: opacity .16s ease, transform .16s ease; }
  .wsz[aria-current="true"] { opacity: 1; transform: scale(1.45); }
  .wpad { flex: 0 0 calc(50% - 32px); }
  .wmark { position: absolute; left: 50%; top: 0; bottom: 4px; width: 62px;
           transform: translateX(-50%); pointer-events: none;
           border-top: 1px solid var(--line); border-bottom: 1px solid var(--accent); }
  .wheel-hint { text-align: center; font-size: 11px; letter-spacing: .05em; color: var(--muted);
                margin-top: 2px; line-height: 1.4; }

  .ask { text-align: center; font-size: 12.5px; line-height: 1.45; margin-bottom: 12px;
         color: var(--muted); }
  .ask b { display: block; font: 300 16px/1.35 var(--head); letter-spacing: .06em;
           text-transform: uppercase; margin-bottom: 4px; color: var(--ink); }
  .answers { display: flex; gap: 8px; }
  .answers button { flex: 1; min-height: 60px; padding: 8px 6px; border: 1px solid var(--ink);
    background: #fff; color: var(--ink); font: 400 11px/1.4 var(--body); letter-spacing: .08em;
    text-transform: uppercase; }
  .answers button.alt { border-color: var(--line); color: var(--muted); }
  .answers button:active { background: var(--ink); color: #fff; }
  .prog { display: flex; gap: 4px; justify-content: center; margin-bottom: 10px; }
  .prog i { width: 16px; height: 2px; background: var(--line); }
  .prog i.on { background: var(--accent); }

  .result { flex: 1; display: flex; flex-direction: column; justify-content: center;
            padding: 22px; text-align: center; overflow-y: auto; }
  .sizes { display: flex; align-items: stretch; justify-content: center; }
  .size-card { flex: 1; padding: 4px 10px; }
  .size-card + .size-card { border-inline-start: 1px solid var(--line); }
  .size-big { font: 200 52px/1 var(--head); letter-spacing: .02em; }
  .size-scale { font: 400 10px/1.3 var(--body); letter-spacing: .16em; text-transform: uppercase;
                color: var(--muted); margin-bottom: 12px; }
  .size-card.secondary .size-big { font-size: 36px; color: var(--muted); padding-top: 14px; }
  .equiv { margin-top: 16px; color: var(--muted); font-size: 12.5px; letter-spacing: .04em; }
  .equiv b { color: var(--ink); font-weight: 400; }
  .notes { margin: 20px 0 0; padding: 16px 0 0; padding-inline-start: 16px; text-align: start;
    font-size: 11.5px; color: var(--muted); line-height: 1.75; border-top: 1px solid var(--line); }
  .notes a { color: var(--accent); }
  /* Plain, quiet, and not hidden behind a link: it has to be readable where the number is. */
  .legal { margin: 18px 0 0; padding: 14px 0 0; border-top: 1px solid var(--line);
           text-align: start; font-size: 10.5px; line-height: 1.7; color: var(--muted);
           letter-spacing: .01em; }
  .legal a { color: var(--muted); text-underline-offset: 2px; }

  .banner { margin: 0 22px 8px; padding: 8px 10px; background: #fbf6f2; color: var(--accent);
    font-size: 11.5px; line-height: 1.5; border-inline-start: 2px solid var(--accent); text-align: start; }
  .banner[hidden] { display: none; }

  /* Desktop. The whole tool rests on knowing the physical size of the glass, and on a desktop
     there is nothing to calibrate against: no model to name, no known screen. Rather than draw
     a circle that is confidently the wrong size, say so and send them to a phone. */
  .desk { flex: 1; display: flex; flex-direction: column; justify-content: center;
          align-items: center; text-align: center; padding: 40px 28px; }
  .phone-glyph { width: 52px; height: 90px; border: 1.5px solid var(--ink); border-radius: 9px;
                position: relative; margin: 0 auto 26px; }
  .phone-glyph::before { content: ""; position: absolute; top: 7px; left: 50%; width: 16px;
                        height: 2px; background: var(--ink); transform: translateX(-50%); }
  .phone-glyph::after { content: ""; position: absolute; width: 26px; height: 26px;
                       border-radius: 50%; background: var(--disc-fill);
                       box-shadow: inset 0 0 0 2px var(--rim-color);
                       left: 50%; top: 52%; transform: translate(-50%, -50%); }
  .desk h1 { margin-bottom: 14px; }
  .desk .phone-glyph { margin-bottom: 26px; }
  .desk p { max-width: 34ch; margin: 0 0 4px; color: var(--muted); font-size: 13px;
            line-height: 1.65; }
  .desk-url { margin-top: 22px; padding: 11px 16px; border: 1px solid var(--line);
              background: var(--surface); font: 400 12px/1.4 var(--body); letter-spacing: .02em;
              color: var(--ink); word-break: break-all; max-width: 100%; direction: ltr; }

  /* Demo only: the build id sits in the corner so a stale cache is obvious at a glance. */
  /* Stays on the live page on purpose: a field report of "it said 49" is unactionable, and
     one screenshot of this panel settles what scale produced it. Small enough to ignore. */
  #dbg-toggle { position: fixed; top: 2px; inset-inline-end: 6px; width: auto; margin: 0;
    padding: 7px 8px; font-size: 8px; letter-spacing: .1em; opacity: .22; z-index: 5;
    text-decoration: none; }
  #dbg { position: fixed; inset: auto 0 0 0; z-index: 6; max-height: 60vh; overflow: auto;
    font: 11px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; background: #14120f;
    color: #b9b2a6; padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
    white-space: pre-wrap; word-break: break-all; margin: 0; direction: ltr; text-align: left; }
  #dbg[hidden] { display: none; }
  #dbg b { color: #f0e9dd; font-weight: 400; }
</style>

<div id="app">
  <!-- STEP 1: calibrate -->
  <section class="step on" id="s-cal">
    <header>
      <div class="pips"><i class="pip on"></i><i class="pip"></i><i class="pip"></i></div>
      <h1 data-t="calTitle"></h1>
      <p class="sub" id="cal-sub"></p>
    </header>
    <div class="methods">
      <button data-method="device" aria-pressed="true" data-t="mDevice"></button>
      <button data-method="card" aria-pressed="false" data-t="mCard"></button>
      <button data-method="coin" aria-pressed="false" data-t="mCoin"></button>
    </div>
    <div class="stage" id="cal-stage">
      <div id="card" hidden><i class="chip"></i></div>
      <div id="coin" hidden></div>
      <div id="devnote" hidden></div>
      <div class="guide" id="g-top"></div>
      <div class="guide" id="g-bot"></div>
      <div class="stage-note" id="cal-note"></div>
    </div>
    <div class="banner" id="cal-banner" hidden></div>
    <div class="controls">
      <select id="device-pick" hidden></select>
      <select id="inch-pick" hidden></select>
      <select id="coin-pick" hidden></select>
      <div class="row" id="cal-row">
        <button class="nudge" data-cal="-1" aria-label="-">&minus;</button>
        <input type="range" id="cal-range" step="0.005">
        <button class="nudge" data-cal="1" aria-label="+">+</button>
      </div>
      <div class="btns"><button class="primary" id="cal-next" data-t="calNext"></button></div>
      <!-- only when the scale cannot be established: a customer whose phone is in no list had
           nowhere left to go, and a dead end on the first screen is a lost customer -->
      <a class="wa" id="cal-wa" target="_blank" rel="noopener" data-t="waHelp" hidden></a>
    </div>
  </section>

  <!-- STEP 2: measure -->
  <section class="step" id="s-measure">
    <header>
      <button class="nav" id="m-nav" data-t="back"></button>
