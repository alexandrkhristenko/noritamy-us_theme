{% comment %}
  Landing page hero: title and intro beside a photo, with two buttons.

  On mobile the title sits above the photo and the caption below it. From 750px the photo and the text
  share the row.
{% endcomment %}

{{ 'section-landing.css' | asset_url | stylesheet_tag }}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--full-width color-{{ section.settings.color_scheme }}">
  <div class="landing-hero" data-landing-section="hero">
    <div class="landing-hero__intro">
      {%- if section.settings.heading != blank -%}
        <h1 class="landing-hero__title h1">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="landing-hero__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="landing-hero__media">
      {%- render 'landing-image',
        image: section.settings.image,
        product: section.settings.image_product,
        media_index: section.settings.image_product_media,
        sizes: '(min-width: 750px) 50vw, 100vw',
        class: 'landing-hero__image',
        eager: true
      -%}
    </div>

    <div class="landing-hero__aside">
      {%- if section.settings.caption != blank or section.settings.caption_link_label != blank -%}
        <div class="landing-hero__caption">
          <span class="h6">{{ section.settings.caption | escape }}</span>
          {%- if section.settings.caption_link_label != blank -%}
            <a class="landing-link h6" href="{{ section.settings.caption_link | escape }}">
              {{- section.settings.caption_link_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank or section.settings.button_2_label != blank -%}
        <div class="landing-hero__buttons">
          {%- if section.settings.button_label != blank -%}
            <a class="button" href="{{ section.settings.button_link | escape }}">{{ section.settings.button_label | escape }}</a>
          {%- endif -%}
          {%- if section.settings.button_2_label != blank -%}
            <a class="button button-secondary" href="{{ section.settings.button_2_link | escape }}">
              {{- section.settings.button_2_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Landing hero",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Initials"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro"
    },
    {
      "type": "header",
      "content": "Photo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave empty to use a product photo instead."
    },
    {
      "type": "product",
      "id": "image_product",
      "label": "Product photo to use"
    },
    {
      "type": "range",
      "id": "image_product_media",
      "label": "Which photo of the product",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 1
    },
    {
      "type": "header",
      "content": "Caption under the photo (mobile)"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption"
    },
    {
      "type": "text",
      "id": "caption_link_label",
      "label": "Link label"
    },
    {
      "type": "text",
      "id": "caption_link",
      "label": "Link",
      "default": "#landing-range"
    },
    {
      "type": "header",
      "content": "Buttons (desktop)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "First button label"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "First button link",
      "default": "#landing-range"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Second button label"
    },
    {
      "type": "text",
      "id": "button_2_link",
      "label": "Second button link",
      "default": "#landing-looks"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Landing hero"
    }
  ]
}
{% endschema %}
