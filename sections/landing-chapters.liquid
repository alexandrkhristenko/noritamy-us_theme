{% comment %}
  Landing page chapters: numbered image + text blocks that tell how a piece is made.
  Stacked on mobile, side by side from 750px.
{% endcomment %}

{{ 'section-landing.css' | asset_url | stylesheet_tag }}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--page-width color-{{ section.settings.color_scheme }}">
  <div class="landing-chapters" style="--landing-chapter-count: {{ section.blocks.size | at_least: 1 }};">
    {%- for block in section.blocks -%}
      <div class="landing-chapter" {{ block.shopify_attributes }}>
        <p class="landing-chapter__head">
          {%- if block.settings.number != blank -%}
            <span class="landing-chapter__number">{{ block.settings.number | escape }}</span>
          {%- endif -%}
          <span class="h4">{{ block.settings.title | escape }}</span>
        </p>
        <div class="landing-chapter__media{% if block.settings.contain %} landing-chapter__media--contain{% endif %}">
          {%- render 'landing-image',
            image: block.settings.image,
            product: block.settings.image_product,
            media_index: block.settings.image_product_media,
            sizes: '(min-width: 750px) 50vw, 100vw',
            class: 'landing-chapter__image'
          -%}
        </div>
        {%- if block.settings.text != blank -%}
          <div class="landing-chapter__text">{{ block.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Landing chapters",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Chapter",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "_01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The line"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Leave empty to use a product photo instead."
        },
        {
          "type": "product",
          "id": "image_product",
          "label": "Product photo to use"
        },
        {
          "type": "range",
          "id": "image_product_media",
          "label": "Which photo of the product",
          "min": 1,
          "max": 12,
          "step": 1,
          "default": 1
        },
        {
          "type": "checkbox",
          "id": "contain",
          "label": "Show the whole photo (no crop)",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing chapters"
    }
  ]
}
{% endschema %}
